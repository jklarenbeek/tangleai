{
  "name": "@tangleai/mas",
  "version": "0.26.2",
  "description": "Tangle AI multi-agent runtime core — the one closed workflow IR, its pure validator/partitioner/lowering over JarenJS flow, and the store-neutral runtime contracts",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.gen.ts",
    "./schemas/mas-workflow": "./schemas/mas-workflow.schema.json",
    "./schemas/mas-registry": "./schemas/mas-registry.schema.json",
    "./schemas/mas-template": "./schemas/mas-template.schema.json",
    "./schemas/mas-runtime": "./schemas/mas-runtime.schema.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/core": "0.87.0",
    "@jarenjs/flow": "0.87.0",
    "@jarenjs/json": "0.87.0",
    "@jarenjs/linq": "0.87.0",
    "@jarenjs/validate": "0.87.0",
    "@jarenjs/mermaid": "0.87.0",
    "@tangleai/models": "^0.26.2",
    "@tangleai/context": "^0.26.2",
    "@tangleai/agents": "^0.26.2"
  },
  "private": false,
  "types": "./src/index.ts",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "schemas/**/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/mas"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
