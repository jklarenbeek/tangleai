{
  "name": "@tangleai/models",
  "version": "0.30.0",
  "description": "Injected model clients, provider adapters, embeddings, replay, routing and structured generation.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./providers": "./src/providers.ts",
    "./sse": "./src/sse.ts",
    "./client": "./src/client.ts",
    "./embed": "./src/embed.ts",
    "./structured": "./src/structured.ts",
    "./errors": "./src/errors.ts",
    "./check": "./src/check.ts",
    "./routing": "./src/routing.ts",
    "./grammar": "./src/grammar.ts",
    "./replay": "./src/replay.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/core": "0.91.3",
    "@jarenjs/validate": "0.91.3"
  },
  "private": false,
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/models"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
