{
  "name": "@tangleai/models",
  "version": "0.21.1",
  "description": "Injected model clients, provider adapters, embeddings, replay, routing and structured generation.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./providers": {
      "types": "./dist/types/providers.d.ts",
      "default": "./src/providers.js"
    },
    "./sse": {
      "types": "./dist/types/sse.d.ts",
      "default": "./src/sse.js"
    },
    "./client": {
      "types": "./dist/types/client.d.ts",
      "default": "./src/client.js"
    },
    "./embed": {
      "types": "./dist/types/embed.d.ts",
      "default": "./src/embed.js"
    },
    "./structured": {
      "types": "./dist/types/structured.d.ts",
      "default": "./src/structured.js"
    },
    "./errors": {
      "types": "./dist/types/errors.d.ts",
      "default": "./src/errors.js"
    },
    "./check": {
      "types": "./dist/types/check.d.ts",
      "default": "./src/check.js"
    },
    "./routing": {
      "types": "./dist/types/routing.d.ts",
      "default": "./src/routing.js"
    },
    "./grammar": {
      "types": "./dist/types/grammar.d.ts",
      "default": "./src/grammar.js"
    },
    "./replay": {
      "types": "./dist/types/replay.d.ts",
      "default": "./src/replay.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/core": "0.84.3",
    "@jarenjs/validate": "0.84.3"
  },
  "private": false,
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/models"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
