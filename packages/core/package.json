{
  "name": "@tangleai/core",
  "version": "0.39.0",
  "description": "Tangle AI core — memory record model, k-means clustering, token heuristics (vector arithmetic is @jarenjs/core/vector's)",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./clustering": "./src/clustering.ts",
    "./tokens": "./src/tokens.ts",
    "./schemas/memory": "./src/schemas/memory.ts",
    "./package.json": "./package.json",
    "./schemas/temporal": "./src/schemas/temporal.ts",
    "./schemas/temporal.schema.json": "./schemas/temporal.schema.json",
    "./schemas/consolidation": "./src/schemas/consolidation.ts",
    "./schemas/consolidation.schema.json": "./schemas/consolidation.schema.json",
    "./lexical": "./src/lexical.ts",
    "./http-capture": "./src/http-capture.ts",
    "./schemas/place": "./src/schemas/place.ts",
    "./schemas/place.schema.json": "./schemas/place.schema.json"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@tangleai/context": "^0.39.0",
    "@jarenjs/validate": "0.91.4",
    "@jarenjs/core": "0.91.4",
    "@jarenjs/json": "0.91.4"
  },
  "private": false,
  "types": "./src/index.ts",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "schemas/**/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/core"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
