{
  "name": "@tangleai/memory",
  "version": "0.27.3",
  "description": "Tangle AI memory policies — novelty gating, crystallization, contradiction resolution, outcome learning — over an injected store",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./store": "./src/store.ts",
    "./ingest": "./src/ingest.ts",
    "./novelty": "./src/novelty.ts",
    "./crystallize": "./src/crystallize.ts",
    "./contradiction": "./src/contradiction.ts",
    "./outcome": "./src/outcome.ts",
    "./retrieval": "./src/retrieval.ts",
    "./package.json": "./package.json",
    "./policy": "./src/policy.ts",
    "./schemas/policy.schema.json": "./schemas/policy.schema.json",
    "./schemas/policy.contract.json": "./schemas/policy.contract.json",
    "./temporal": "./src/temporal/index.ts",
    "./consolidation": "./src/consolidation/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/contract": "0.89.0",
    "@jarenjs/core": "0.89.0",
    "@jarenjs/json": "0.89.0",
    "@jarenjs/locales": "0.89.0",
    "@jarenjs/validate": "0.89.0",
    "@tangleai/context": "^0.27.3",
    "@tangleai/core": "^0.27.3",
    "@tangleai/models": "^0.27.3"
  },
  "private": false,
  "types": "./src/index.ts",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "schemas/**/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/**/*.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/memory"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
