{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tangleai.dev/schemas/run-identity",
  "$anchor": "runIdentity",
  "title": "Run identity — the requested/effective contract every result refers to",
  "description": "One complete, credential-free run identity: the exact request (profile, tag or generated legacy projection, plus role overrides) AND the complete effective stack — provider, suite-normalized base, model, inference controls, prompt and response-schema revisions, effective tool manifest, the one singleton embedding identity, policy/ranker component references, the effective budget and rate-card provenance. `identityId` is canonical SHA-256 over the identity's own payload excluding the id field; no clock, observation, usage, latency, key, secret or cache identifier is ever part of that payload. Reports and stores carry these in the `identityEnvelope` shape defined here: a table of identities and rows that either reference one (`run`), state that they are analysis that never ran a stack (`not-run`), or state that their facts were never recorded (`legacy-unrecorded`) — an absence is a stated absence, never a fabricated identity. Every object closes its properties, so a credential-shaped member cannot be carried.",
  "type": "object",
  "required": [
    "identityId",
    "registryRevision",
    "hostManifestRevision",
    "requested",
    "roles",
    "embedding",
    "components",
    "budget"
  ],
  "additionalProperties": false,
  "properties": {
    "identityId": {
      "$ref": "#/$defs/sha256"
    },
    "registryRevision": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "hostManifestRevision": {
      "$ref": "#/$defs/sha256"
    },
    "requested": {
      "$ref": "#/$defs/profileRequest"
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/effectiveRole"
      }
    },
    "embedding": {
      "description": "The one embedding identity of the run, or null when the stack resolved no embedding component (a legacy request whose configured wire was never proven by this run's work). A profile request always resolves one.",
      "oneOf": [
        {
          "$ref": "#/$defs/effectiveEmbedding"
        },
        {
          "type": "null"
        }
      ]
    },
    "components": {
      "type": "object",
      "required": [
        "policy",
        "ranker"
      ],
      "additionalProperties": false,
      "properties": {
        "policy": {
          "$ref": "#/$defs/componentRevision"
        },
        "ranker": {
          "$ref": "#/$defs/componentRevision"
        }
      }
    },
    "budget": {
      "$ref": "#/$defs/budgetCeilings"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "toolName": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "safeBaseUrl": {
      "type": "string",
      "pattern": "^https?://[^@?#\\s]+$"
    },
    "issueCode": {
      "description": "Stable machine refusal/validation codes. TCFG1001 unknown capability tag; TCFG1002 unknown parent; TCFG1003 inheritance cycle; TCFG1004 duplicate id; TCFG1005 unresolvable reference; TCFG1006 role/candidate kind mismatch; TCFG1007 invalid document; TCFG1008 unavailable credential slot; TCFG1009 provider/model unavailable on host; TCFG1010 required feature unavailable; TCFG1011 missing required tool; TCFG1012 embedding identity disagreement; TCFG1013 credential-bearing URL; TCFG1014 secret-shaped member; TCFG1015 no available candidate for tag; TCFG1016 profile attempts to raise a host ceiling; TCFG1017 component unavailable at revision; TCFG1018 row references no identity; TCFG1019 registry revision mismatch; TCFG1020 invalid role override; TCFG1021 incomplete wire request.",
      "type": "string",
      "pattern": "^TCFG1[0-9]{3}$"
    },
    "issue": {
      "type": "object",
      "required": [
        "code",
        "path",
        "detail"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/issueCode"
        },
        "path": {
          "type": "string"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rateCard": {
      "type": "object",
      "required": [
        "currency",
        "inputPerMillionTokens",
        "outputPerMillionTokens",
        "source",
        "asOf"
      ],
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "inputPerMillionTokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "outputPerMillionTokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "asOf": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "credentialSlotStatus": {
      "description": "Slot presence only. `source` names WHERE a value would come from (an environment variable name, `settings`), never the value.",
      "type": "object",
      "required": [
        "name",
        "configured",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "configured": {
          "type": "boolean"
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "hostManifest": {
      "description": "The credential-free host facts pure resolution consumes. Endpoints are suite-normalized bases; models/features are declared or probed; `observation` dates a LIVE refresh and stays null for synthetic/keyless manifests, which must be clock-free.",
      "type": "object",
      "required": [
        "sourceClass",
        "credentialSlots",
        "providers",
        "embedding",
        "tools",
        "components",
        "budget",
        "observation"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceClass": {
          "enum": [
            "desktop-settings",
            "environment",
            "synthetic",
            "scripted"
          ]
        },
        "credentialSlots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/credentialSlotStatus"
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "provider",
              "base",
              "models",
              "features"
            ],
            "additionalProperties": false,
            "properties": {
              "provider": {
                "enum": [
                  "openrouter",
                  "ollama",
                  "lmstudio",
                  "custom"
                ]
              },
              "base": {
                "$ref": "#/$defs/safeBaseUrl"
              },
              "models": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "features": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/name"
                }
              }
            }
          }
        },
        "embedding": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "provider",
              "base",
              "model",
              "dims"
            ],
            "additionalProperties": false,
            "properties": {
              "provider": {
                "enum": [
                  "openrouter",
                  "ollama",
                  "lmstudio",
                  "custom",
                  "builtin"
                ]
              },
              "base": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/safeBaseUrl"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "dims": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              }
            }
          }
        },
        "tools": {
          "description": "The compiled toolbox manifest — `createToolbox().list()` with each input schema's canonical revision.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "description",
              "inputSchemaRevision"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/toolName"
              },
              "description": {
                "type": "string"
              },
              "inputSchemaRevision": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "revision"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/name"
              },
              "revision": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "budget": {
          "$ref": "#/$defs/budgetCeilings"
        },
        "observation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind",
                "at",
                "calls",
                "failures"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "declared",
                    "probed"
                  ]
                },
                "at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "calls": {
                  "type": "integer",
                  "minimum": 0
                },
                "failures": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        }
      }
    },
    "budgetCeilings": {
      "type": "object",
      "required": [
        "maxCalls",
        "maxTokens",
        "maxMs",
        "maxConcurrency"
      ],
      "additionalProperties": false,
      "properties": {
        "maxCalls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maxTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maxMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maxConcurrency": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "roleOverride": {
      "description": "What a request may override per role — never a credential slot, host availability or a permission.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        },
        "responseSchema": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolName"
          }
        },
        "toolsRequired": {
          "type": "boolean"
        },
        "inference": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranker": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "legacyWireState": {
      "description": "The generated projection of pre-profile desktop/environment settings for ONE wire. `unconfigured` is the only state eligible for built-in/grounded fallback; `incomplete` names what was requested and resolves to an issue, never to a silent substitute. `configured-unproven` records a wire that was configured but whose width no work of this run ever observed: the stack claims NO embedding identity rather than guessing one.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unconfigured"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state",
            "provider",
            "baseUrl",
            "model",
            "credentialSlot"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "configured"
            },
            "provider": {
              "enum": [
                "openrouter",
                "ollama",
                "lmstudio",
                "custom"
              ]
            },
            "baseUrl": {
              "oneOf": [
                {
                  "$ref": "#/$defs/safeBaseUrl"
                },
                {
                  "type": "null"
                }
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "credentialSlot": {
              "oneOf": [
                {
                  "$ref": "#/$defs/name"
                },
                {
                  "type": "null"
                }
              ]
            },
            "inference": {
              "$ref": "#/$defs/inferenceControls"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state",
            "requested",
            "missing"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "incomplete"
            },
            "requested": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "baseUrl": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "missing": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state",
            "provider",
            "baseUrl",
            "model",
            "credentialSlot"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "configured-unproven"
            },
            "provider": {
              "enum": [
                "openrouter",
                "ollama",
                "lmstudio",
                "custom"
              ]
            },
            "baseUrl": {
              "oneOf": [
                {
                  "$ref": "#/$defs/safeBaseUrl"
                },
                {
                  "type": "null"
                }
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "credentialSlot": {
              "oneOf": [
                {
                  "$ref": "#/$defs/name"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "profileRequest": {
      "description": "Exactly what was asked for: a named profile, a capability tag, or the generated legacy projection of pre-profile settings.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "profile",
            "overrides"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "profile"
            },
            "profile": {
              "$ref": "#/$defs/name"
            },
            "overrides": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/roleOverride"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "tag",
            "overrides"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "tag"
            },
            "tag": {
              "$ref": "#/$defs/name"
            },
            "overrides": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/roleOverride"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "chat",
            "embed",
            "components",
            "chatPrompt"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "legacy"
            },
            "chat": {
              "$ref": "#/$defs/legacyWireState"
            },
            "embed": {
              "$ref": "#/$defs/legacyWireState"
            },
            "components": {
              "description": "The component references the host product genuinely runs for a legacy request — the shipped policy pipeline and ranker — recorded by the adapter that generated the projection, never guessed.",
              "type": "object",
              "required": [
                "policy",
                "ranker"
              ],
              "additionalProperties": false,
              "properties": {
                "policy": {
                  "$ref": "#/$defs/componentRevision"
                },
                "ranker": {
                  "$ref": "#/$defs/componentRevision"
                }
              }
            },
            "chatPrompt": {
              "description": "The versioned chat template the legacy host actually uses, as a content revision; null when no chat surface exists.",
              "oneOf": [
                {
                  "$ref": "#/$defs/contentRevision"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "toolManifest": {
      "description": "Requested set and the effective intersection with the host allowlist. A missing required tool refuses before an identity exists, so an identity's manifest never carries one.",
      "type": "object",
      "required": [
        "requested",
        "effective"
      ],
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolName"
          }
        },
        "effective": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "inputSchemaRevision"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/toolName"
              },
              "inputSchemaRevision": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "inferenceControls": {
      "type": "object",
      "required": [
        "temperature",
        "maxTokens",
        "retry",
        "reasoning"
      ],
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 2
        },
        "maxTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "retry": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "attempts",
                "baseMs",
                "maxMs"
              ],
              "additionalProperties": false,
              "properties": {
                "attempts": {
                  "type": "integer",
                  "minimum": 1
                },
                "baseMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxMs": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "reasoning": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "effort": {
                  "enum": [
                    "none",
                    "minimal",
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "enabled": {
                  "type": "boolean"
                },
                "exclude": {
                  "type": "boolean"
                },
                "maxTokens": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "maxTokensField": {
          "enum": [
            "max_tokens",
            "max_completion_tokens"
          ]
        }
      }
    },
    "contentRevision": {
      "type": "object",
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "revision": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "effectiveRole": {
      "description": "Everything that role actually runs with — the values, not the intent that selected them.",
      "type": "object",
      "required": [
        "provider",
        "base",
        "model",
        "credentialSlot",
        "inference",
        "prompt",
        "responseSchema",
        "tools",
        "rateCard"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "openrouter",
            "ollama",
            "lmstudio",
            "custom"
          ]
        },
        "base": {
          "$ref": "#/$defs/safeBaseUrl"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "credentialSlot": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        },
        "inference": {
          "$ref": "#/$defs/inferenceControls"
        },
        "prompt": {
          "oneOf": [
            {
              "$ref": "#/$defs/contentRevision"
            },
            {
              "type": "null"
            }
          ]
        },
        "responseSchema": {
          "oneOf": [
            {
              "$ref": "#/$defs/contentRevision"
            },
            {
              "type": "null"
            }
          ]
        },
        "tools": {
          "$ref": "#/$defs/toolManifest"
        },
        "rateCard": {
          "oneOf": [
            {
              "$ref": "#/$defs/rateCard"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "effectiveEmbedding": {
      "description": "The one embedding identity of the run — every corpus and query vector in the run uses it. Dims are the registry value CONFIRMED against a probe/reply, never guessed from a model label.",
      "type": "object",
      "required": [
        "provider",
        "base",
        "model",
        "dims",
        "credentialSlot"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "openrouter",
            "ollama",
            "lmstudio",
            "custom",
            "builtin"
          ]
        },
        "base": {
          "oneOf": [
            {
              "$ref": "#/$defs/safeBaseUrl"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "dims": {
          "type": "integer",
          "minimum": 1
        },
        "credentialSlot": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "componentRevision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "id",
            "revision"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/name"
            },
            "revision": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "identityEnvelope": {
      "description": "The identity table plus the rows that refer to it — the shape every identity-bearing report and store carries. The `$query` assertions bind at validation time: identity ids are unique, row ids are unique, and every `run` row resolves to exactly one identity in the table.",
      "type": "object",
      "required": [
        "identities",
        "rows"
      ],
      "additionalProperties": false,
      "$query": {
        "$and": [
          {
            "$eq": [
              {
                "$count": "$.identities[*].identityId"
              },
              {
                "$count": {
                  "$distinct": "$.identities[*].identityId"
                }
              }
            ]
          },
          {
            "$eq": [
              {
                "$count": "$.rows[*].rowId"
              },
              {
                "$count": {
                  "$distinct": "$.rows[*].rowId"
                }
              }
            ]
          },
          {
            "$every": {
              "r": "$.rows[?(@.identityStatus=='run')]"
            },
            "$satisfies": {
              "$exists": {
                "$index-of": [
                  "$.identities[*].identityId",
                  "$r.identityId"
                ]
              }
            }
          }
        ]
      },
      "properties": {
        "identities": {
          "type": "array",
          "items": {
            "$ref": "#runIdentity"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rowIdentityRef"
          }
        }
      }
    },
    "resolution": {
      "description": "The pure resolver's only two outcomes. Refusal is a value: sorted stable issues with document paths, no secret in any detail.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "ok",
            "identity"
          ],
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true
            },
            "identity": {
              "$ref": "#runIdentity"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "ok",
            "issues"
          ],
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false
            },
            "issues": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/issue"
              }
            }
          }
        }
      ]
    },
    "rowIdentityRef": {
      "description": "How a result row refers to the identity table. `run` rows name an identity that exists; `not-run` rows are analytic (a ceiling, a census) and cannot pretend to a provider; `legacy-unrecorded` rows keep historic results whose stack was never captured — honest absence, never a backfilled guess.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "rowId",
            "identityStatus",
            "identityId"
          ],
          "additionalProperties": false,
          "properties": {
            "rowId": {
              "type": "string",
              "minLength": 1
            },
            "identityStatus": {
              "const": "run"
            },
            "identityId": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "rowId",
            "identityStatus"
          ],
          "additionalProperties": false,
          "properties": {
            "rowId": {
              "type": "string",
              "minLength": 1
            },
            "identityStatus": {
              "enum": [
                "not-run",
                "legacy-unrecorded"
              ]
            }
          }
        }
      ]
    }
  }
}
