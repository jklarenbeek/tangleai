{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tangleai.dev/schemas/profile-registry",
  "title": "Capability-profile registry — the one validated configuration document",
  "description": "The registry names credential-free candidates, extensible capability intents, prompt/response-schema/component revisions, inference and budget presets, and the profiles that select among them. A capability tag is a declared intent with ordered candidates and stated limitations, never an adjective proven by its spelling. Every object closes its properties so a member nobody declared — an API key, a token — cannot be carried at all; credential access is only ever a slot NAME. Cross-references are asserted here through `$query` at validation time, so a registry that names a candidate, prompt, component, preset or parent that does not exist cannot validate at all. Child profiles carry exactly one `extends` parent and an RFC 7396 merge patch; the merged result is validated against this same document again, which is why the patch member is the one deliberately open object in the file.",
  "type": "object",
  "required": ["version", "credentialSlots", "candidates", "capabilities", "prompts", "responseSchemas", "components", "inference", "budgets", "profiles"],
  "additionalProperties": false,
  "$query": {
    "$and": [
      { "$eq": [{ "$count": "$.credentialSlots[*]" }, { "$count": { "$distinct": "$.credentialSlots[*]" } }] },
      { "$eq": [{ "$count": "$.candidates[*].id" }, { "$count": { "$distinct": "$.candidates[*].id" } }] },
      { "$eq": [{ "$count": "$.capabilities[*].tag" }, { "$count": { "$distinct": "$.capabilities[*].tag" } }] },
      { "$eq": [{ "$count": "$.prompts[*].id" }, { "$count": { "$distinct": "$.prompts[*].id" } }] },
      { "$eq": [{ "$count": "$.responseSchemas[*].id" }, { "$count": { "$distinct": "$.responseSchemas[*].id" } }] },
      { "$eq": [{ "$count": "$.components[*].id" }, { "$count": { "$distinct": "$.components[*].id" } }] },
      { "$eq": [{ "$count": "$.inference[*].id" }, { "$count": { "$distinct": "$.inference[*].id" } }] },
      { "$eq": [{ "$count": "$.budgets[*].id" }, { "$count": { "$distinct": "$.budgets[*].id" } }] },
      { "$eq": [{ "$count": "$.profiles[*].id" }, { "$count": { "$distinct": "$.profiles[*].id" } }] },
      { "$every": { "c": "$.capabilities[*].candidates[*]" }, "$satisfies": { "$exists": { "$index-of": ["$.candidates[*].id", "$c.candidate"] } } },
      { "$every": { "s": "$.candidates[*].credentialSlot" }, "$satisfies": { "$or": [{ "$eq": ["$s", null] }, { "$exists": { "$index-of": ["$.credentialSlots[*]", "$s"] } }] } },
      { "$every": { "p": "$.profiles[*]" }, "$satisfies": { "$or": [{ "$eq": ["$p.kind", "child"] }, { "$exists": { "$index-of": ["$.candidates[?(@.kind=='embedding')].id", "$p.embedding"] } }] } },
      { "$every": { "r": "$.profiles[*].roles[*]" }, "$satisfies": { "$or": [{ "$eq": ["$r.candidate", null] }, { "$exists": { "$index-of": ["$.candidates[?(@.kind=='chat')].id", "$r.candidate"] } }] } },
      { "$every": { "r": "$.profiles[*].roles[*]" }, "$satisfies": { "$or": [{ "$eq": ["$r.capability", null] }, { "$exists": { "$index-of": ["$.capabilities[*].tag", "$r.capability"] } }] } },
      { "$every": { "r": "$.profiles[*].roles[*]" }, "$satisfies": { "$not": { "$eq": [{ "$eq": ["$r.capability", null] }, { "$eq": ["$r.candidate", null] }] } } },
      { "$every": { "r": "$.profiles[*].roles[*]" }, "$satisfies": { "$or": [{ "$eq": ["$r.prompt", null] }, { "$exists": { "$index-of": ["$.prompts[*].id", "$r.prompt"] } }] } },
      { "$every": { "r": "$.profiles[*].roles[*]" }, "$satisfies": { "$or": [{ "$eq": ["$r.responseSchema", null] }, { "$exists": { "$index-of": ["$.responseSchemas[*].id", "$r.responseSchema"] } }] } },
      { "$every": { "r": "$.profiles[*].roles[*]" }, "$satisfies": { "$or": [{ "$eq": ["$r.inference", null] }, { "$exists": { "$index-of": ["$.inference[*].id", "$r.inference"] } }] } },
      { "$every": { "r": "$.profiles[*].roles[*]" }, "$satisfies": { "$or": [{ "$eq": ["$r.ranker", null] }, { "$exists": { "$index-of": ["$.components[?(@.kind=='ranker')].id", "$r.ranker"] } }] } },
      { "$every": { "p": "$.profiles[?(@.kind=='root')]" }, "$satisfies": { "$or": [{ "$eq": ["$p.policyComponent", null] }, { "$exists": { "$index-of": ["$.components[?(@.kind=='policy')].id", "$p.policyComponent"] } }] } },
      { "$every": { "p": "$.profiles[?(@.kind=='root')]" }, "$satisfies": { "$or": [{ "$eq": ["$p.budget", null] }, { "$exists": { "$index-of": ["$.budgets[*].id", "$p.budget"] } }] } },
      { "$every": { "p": "$.profiles[?(@.kind=='child')]" }, "$satisfies": { "$exists": { "$index-of": ["$.profiles[*].id", "$p.extends"] } } }
    ]
  },
  "properties": {
    "version": { "const": 1, "description": "Registry document format version." },
    "credentialSlots": {
      "description": "Declared credential slot NAMES. A slot never holds a value here; the host binds values in memory only.",
      "type": "array",
      "items": { "$ref": "#/$defs/slotName" }
    },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "capabilities": {
      "description": "Extensible intent tags. The seeded three are `reasoning`, `fast` and `cheap`; nothing in this schema or its consumers makes those spellings special.",
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "prompts": { "type": "array", "items": { "$ref": "#/$defs/contentRef" } },
    "responseSchemas": { "type": "array", "items": { "$ref": "#/$defs/contentRef" } },
    "components": { "type": "array", "items": { "$ref": "#/$defs/componentRef" } },
    "inference": { "type": "array", "items": { "$ref": "#/$defs/inferencePreset" } },
    "budgets": { "type": "array", "items": { "$ref": "#/$defs/budgetPreset" } },
    "profiles": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/rootProfile" },
          { "$ref": "#/$defs/childProfile" }
        ]
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "name": {
      "description": "Lower-case hyphenated identifier — capability tags, slot names, ids.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "slotName": { "$ref": "#/$defs/name" },
    "toolName": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$" },
    "safeBaseUrl": {
      "description": "An http(s) base URL with no userinfo, query or fragment — a URL that could smuggle a credential cannot validate.",
      "type": "string",
      "pattern": "^https?://[^@?#\\s]+$"
    },
    "rateCard": {
      "description": "Sourced cost metadata. Absence on a candidate means cost UNKNOWN, never free.",
      "type": "object",
      "required": ["currency", "inputPerMillionTokens", "outputPerMillionTokens", "source", "asOf"],
      "additionalProperties": false,
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "inputPerMillionTokens": { "type": ["number", "null"], "minimum": 0 },
        "outputPerMillionTokens": { "type": ["number", "null"], "minimum": 0 },
        "source": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "candidate": {
      "description": "A credential-free model candidate. `credentialSlot` names a slot; the value never appears. `builtin` is only an embedding provider (the offline reference embedder), and a `custom` provider must declare its base because no default exists for it.",
      "type": "object",
      "required": ["id", "kind", "provider", "model", "baseUrl", "credentialSlot", "features", "rateCard"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["chat", "embedding"] },
        "provider": { "enum": ["openrouter", "ollama", "lmstudio", "custom", "builtin"] },
        "model": { "type": "string", "minLength": 1 },
        "baseUrl": { "oneOf": [{ "$ref": "#/$defs/safeBaseUrl" }, { "type": "null" }] },
        "credentialSlot": { "oneOf": [{ "$ref": "#/$defs/slotName" }, { "type": "null" }] },
        "features": { "type": "array", "items": { "$ref": "#/$defs/name" } },
        "dims": { "type": "integer", "minimum": 1 },
        "rateCard": { "oneOf": [{ "$ref": "#/$defs/rateCard" }, { "type": "null" }] },
        "limitations": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "embedding" } } }, "then": { "required": ["dims"] } },
        { "if": { "properties": { "kind": { "const": "chat" } } }, "then": { "not": { "required": ["dims"] } } },
        { "if": { "properties": { "provider": { "const": "builtin" } } }, "then": { "properties": { "kind": { "const": "embedding" }, "baseUrl": { "type": "null" }, "credentialSlot": { "type": "null" } } } },
        { "if": { "properties": { "provider": { "const": "custom" } } }, "then": { "properties": { "baseUrl": { "$ref": "#/$defs/safeBaseUrl" } } } }
      ]
    },
    "capability": {
      "type": "object",
      "required": ["tag", "intent", "candidates", "limitations"],
      "additionalProperties": false,
      "properties": {
        "tag": { "$ref": "#/$defs/name" },
        "intent": { "type": "string", "minLength": 1 },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["candidate", "priority"],
            "additionalProperties": false,
            "properties": {
              "candidate": { "$ref": "#/$defs/name" },
              "priority": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "limitations": { "type": "string", "minLength": 1 }
      }
    },
    "contentRef": {
      "description": "A versioned content reference — a prompt pack/template or a structured-output response schema. The revision is the canonical SHA-256 of the referenced content, computed by its owner.",
      "type": "object",
      "required": ["id", "revision", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "revision": { "$ref": "#/$defs/sha256" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "componentRef": {
      "description": "A public reference to a policy or ranker component owned by its domain package. The registry holds only the reference and revision; the values and the decision that selected them stay with the owner.",
      "type": "object",
      "required": ["id", "kind", "package", "export", "revision", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["policy", "ranker"] },
        "package": { "type": "string", "pattern": "^@(tangleai|jarenjs)/[a-z0-9-]+$" },
        "export": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/sha256" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "inferencePreset": {
      "type": "object",
      "required": ["id", "temperature", "maxTokens", "retry", "reasoning"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "temperature": { "type": ["number", "null"], "minimum": 0, "maximum": 2 },
        "maxTokens": { "type": ["integer", "null"], "minimum": 1 },
        "retry": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["attempts", "baseMs", "maxMs"],
              "additionalProperties": false,
              "properties": {
                "attempts": { "type": "integer", "minimum": 1 },
                "baseMs": { "type": "integer", "minimum": 0 },
                "maxMs": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        },
        "reasoning": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "effort": { "enum": ["none", "minimal", "low", "medium", "high"] },
                "enabled": { "type": "boolean" },
                "exclude": { "type": "boolean" },
                "maxTokens": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        }
      }
    },
    "budgetPreset": {
      "description": "Requested ceilings. A profile may lower a host ceiling and can never raise one; the host's hard ceilings always win.",
      "type": "object",
      "required": ["id", "maxCalls", "maxTokens", "maxMs", "maxConcurrency"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "maxCalls": { "type": ["integer", "null"], "minimum": 1 },
        "maxTokens": { "type": ["integer", "null"], "minimum": 1 },
        "maxMs": { "type": ["integer", "null"], "minimum": 1 },
        "maxConcurrency": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "roleSpec": {
      "description": "One chat role of a profile. Exactly one of `capability` (resolve by intent) or `candidate` (pin one) is set. Tools are requested names — the effective manifest is the intersection with the host allowlist; a request is never permission.",
      "type": "object",
      "required": ["capability", "candidate", "prompt", "responseSchema", "tools", "toolsRequired", "inference", "ranker"],
      "additionalProperties": false,
      "properties": {
        "capability": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] },
        "candidate": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] },
        "prompt": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] },
        "responseSchema": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/toolName" } },
        "toolsRequired": { "type": "boolean" },
        "inference": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] },
        "ranker": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] }
      }
    },
    "rootProfile": {
      "type": "object",
      "required": ["id", "kind", "description", "roles", "embedding", "policyComponent", "budget"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "kind": { "const": "root" },
        "description": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "additionalProperties": { "$ref": "#/$defs/roleSpec" }
        },
        "embedding": { "$ref": "#/$defs/name" },
        "policyComponent": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] },
        "budget": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] }
      }
    },
    "childProfile": {
      "description": "Single-parent inheritance: the RFC 7396 patch is applied to the RESOLVED parent by `@jarenjs/json.applyMergePatch`, and the merged document must validate as a root profile again. The patch is the one open object in this schema — its members are judged after the merge, so an undeclared member still cannot survive.",
      "type": "object",
      "required": ["id", "kind", "extends", "patch"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "kind": { "const": "child" },
        "extends": { "$ref": "#/$defs/name" },
        "patch": { "type": "object" }
      }
    }
  }
}
