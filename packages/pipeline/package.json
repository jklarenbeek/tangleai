{
  "name": "@tangleai/pipeline",
  "version": "0.24.1",
  "description": "Tangle AI pipeline — the memory loop as a jaren-dag document, executed by @jarenjs/flow, projected to mermaid for display",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dag": "./src/dag.ts",
    "./run": "./src/run.ts",
    "./mermaid": "./src/mermaid.ts",
    "./standins": "./src/standins.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@tangleai/core": "^0.24.1",
    "@tangleai/memory": "^0.24.1",
    "@jarenjs/flow": "0.86.0",
    "@jarenjs/json": "0.86.0",
    "@jarenjs/mermaid": "0.86.0",
    "@tangleai/models": "^0.24.1"
  },
  "private": false,
  "types": "./src/index.ts",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "schemas/**/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/pipeline"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
