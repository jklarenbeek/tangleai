{
  "name": "@tangleai/experiential",
  "version": "0.43.1",
  "description": "Closed records and validation for evidence-bound experiential learning",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.gen.ts",
    "./schemas/experiential": "./schemas/experiential.schema.json",
    "./package.json": "./package.json",
    "./schemas/training-service": "./schemas/training-service.contract.json",
    "./contract": "./src/contract.ts",
    "./schemas/contract": "./schemas/experiential.contract.json"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/core": "0.176.8",
    "@jarenjs/json": "0.176.8",
    "@jarenjs/validate": "0.176.8",
    "@tangleai/outcomes": "^0.43.1",
    "@jarenjs/contract": "0.176.8",
    "@tangleai/documents": "^0.43.1",
    "@tangleai/config": "^0.43.1",
    "@tangleai/models": "^0.43.1"
  },
  "private": false,
  "types": "./src/index.ts",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "schemas/**/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/**/*.md",
    "templates/**/*.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/experiential"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
