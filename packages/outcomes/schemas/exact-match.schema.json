{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tangleai.dev/outcomes/exact-match",
  "$ref": "#/$defs/artifact",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "token"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "fallbackLabel": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rules": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "prefix": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "prefix",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "fallbackLabel",
        "rules"
      ],
      "additionalProperties": false
    }
  }
}
