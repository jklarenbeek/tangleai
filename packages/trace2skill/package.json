{
  "name": "@tangleai/trace2skill",
  "version": "0.30.0",
  "description": "Immutable skill directories, anchored directory patches and revision-fenced activation for skill evolution",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.gen.ts",
    "./schemas/trace2skill": "./schemas/trace2skill.schema.json",
    "./artifacts": "./artifacts/prompts.json",
    "./node": "./src/node.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/core": "0.91.3",
    "@jarenjs/josl": "0.91.3",
    "@jarenjs/json": "0.91.3",
    "@jarenjs/validate": "0.91.3",
    "@tangleai/agents": "^0.30.0",
    "@tangleai/mas": "^0.30.0",
    "@tangleai/models": "^0.30.0",
    "@tangleai/outcomes": "^0.30.0"
  },
  "private": false,
  "types": "./src/index.ts",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "schemas/**/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/**/*.md",
    "artifacts/**/*.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/trace2skill"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
