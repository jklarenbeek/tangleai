{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tangleai.dev/schemas/trace2skill",
  "$ref": "#/$defs/skillBundle",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "skillPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/-]*$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "trace2SkillIssue": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "TT2S1001",
            "TT2S1002",
            "TT2S1003",
            "TT2S1004",
            "TT2S1005",
            "TT2S1006",
            "TT2S1007",
            "TT2S1008",
            "TT2S1009",
            "TT2S1010",
            "TT2S1011",
            "TT2S1012",
            "TT2S1013"
          ]
        },
        "path": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "cause": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "docPath": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "docPath",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "code",
        "path",
        "detail"
      ],
      "additionalProperties": false
    },
    "spend": {
      "type": "object",
      "properties": {
        "calls": {
          "$ref": "#/$defs/count"
        },
        "tokens": {
          "$ref": "#/$defs/count"
        },
        "cost": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "calls",
        "tokens",
        "cost"
      ],
      "additionalProperties": false
    },
    "fileDigest": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/skillPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "additionalProperties": false
    },
    "skillFile": {
      "type": "object",
      "properties": {
        "bundleId": {
          "$ref": "#/$defs/sha256"
        },
        "path": {
          "$ref": "#/$defs/skillPath"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "encoding": {
          "enum": [
            "utf-8",
            "binary"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "$ref": "#/$defs/count"
        },
        "executable": {
          "type": "boolean"
        },
        "content": {
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "bundleId",
        "path",
        "mediaType",
        "encoding",
        "sha256",
        "size",
        "executable",
        "content",
        "address"
      ],
      "additionalProperties": false
    },
    "skillBundle": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/sha256"
        },
        "scopeKey": {
          "$ref": "#/$defs/id"
        },
        "mode": {
          "enum": [
            "deepening",
            "creation"
          ]
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "rootFile": {
          "const": "SKILL.md"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fileDigest"
          }
        },
        "origin": {
          "enum": [
            "human-import",
            "parametric-draft",
            "evolved"
          ]
        },
        "status": {
          "enum": [
            "staged",
            "eligible",
            "active",
            "rejected",
            "archived"
          ]
        },
        "formatProfile": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "scopeKey",
        "mode",
        "parentId",
        "rootFile",
        "files",
        "origin",
        "status",
        "formatProfile"
      ],
      "additionalProperties": false
    },
    "skillHead": {
      "type": "object",
      "properties": {
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "versionId",
        "revision"
      ],
      "additionalProperties": false
    },
    "evolutionTask": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "scopeKey": {
          "$ref": "#/$defs/id"
        },
        "split": {
          "enum": [
            "evolve",
            "test"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileDigest"
          }
        },
        "adapterId": {
          "$ref": "#/$defs/id"
        },
        "adapterRevision": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "scopeKey",
        "split",
        "prompt",
        "inputs",
        "adapterId",
        "adapterRevision"
      ],
      "additionalProperties": false
    },
    "roleIdentity": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "draft",
            "executor",
            "success-analyst",
            "error-analyst",
            "merge"
          ]
        },
        "identityId": {
          "$ref": "#/$defs/id"
        },
        "promptVersion": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "role",
        "identityId",
        "promptVersion"
      ],
      "additionalProperties": false
    },
    "evolutionRun": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/sha256"
        },
        "scopeKey": {
          "$ref": "#/$defs/id"
        },
        "mode": {
          "enum": [
            "deepening",
            "creation"
          ]
        },
        "s0Id": {
          "$ref": "#/$defs/sha256"
        },
        "s0Hash": {
          "$ref": "#/$defs/sha256"
        },
        "evolveHash": {
          "$ref": "#/$defs/sha256"
        },
        "testHash": {
          "$ref": "#/$defs/sha256"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/roleIdentity"
          }
        },
        "toolManifestHash": {
          "$ref": "#/$defs/sha256"
        },
        "budgets": {
          "type": "object",
          "properties": {
            "turns": {
              "$ref": "#/$defs/count"
            },
            "tokens": {
              "$ref": "#/$defs/count"
            },
            "ms": {
              "$ref": "#/$defs/count"
            }
          },
          "required": [
            "turns",
            "tokens",
            "ms"
          ],
          "additionalProperties": false
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "bMerge": {
          "type": "integer",
          "minimum": 2
        },
        "lMax": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer"
        },
        "supportThreshold": {
          "$ref": "#/$defs/count"
        },
        "status": {
          "enum": [
            "planned",
            "running",
            "completed",
            "refused"
          ]
        },
        "spend": {
          "$ref": "#/$defs/spend"
        }
      },
      "required": [
        "id",
        "scopeKey",
        "mode",
        "s0Id",
        "s0Hash",
        "evolveHash",
        "testHash",
        "roles",
        "toolManifestHash",
        "budgets",
        "concurrency",
        "bMerge",
        "lMax",
        "seed",
        "supportThreshold",
        "status",
        "spend"
      ],
      "additionalProperties": false
    },
    "rolloutMessage": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "additionalProperties": false
    },
    "rolloutReasoning": {
      "type": "object",
      "properties": {
        "turn": {
          "$ref": "#/$defs/count"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "turn",
        "text"
      ],
      "additionalProperties": false
    },
    "rolloutStep": {
      "type": "object",
      "properties": {
        "turn": {
          "$ref": "#/$defs/count"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "string"
        },
        "result": {
          "type": "string"
        }
      },
      "required": [
        "turn",
        "name",
        "arguments",
        "result"
      ],
      "additionalProperties": false
    },
    "rolloutArtifact": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "$ref": "#/$defs/count"
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "sha256",
        "size",
        "address"
      ],
      "additionalProperties": false
    },
    "taskEvaluation": {
      "type": "object",
      "properties": {
        "evaluatorId": {
          "$ref": "#/$defs/id"
        },
        "score": {
          "type": "number"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "evaluatorId",
        "score",
        "detail"
      ],
      "additionalProperties": false
    },
    "taskRollout": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/sha256"
        },
        "runId": {
          "$ref": "#/$defs/sha256"
        },
        "taskId": {
          "$ref": "#/$defs/id"
        },
        "s0Hash": {
          "$ref": "#/$defs/sha256"
        },
        "condition": {
          "$ref": "#/$defs/id"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rolloutMessage"
          }
        },
        "reasoning": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rolloutReasoning"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rolloutStep"
          }
        },
        "finalAnswer": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rolloutArtifact"
          }
        },
        "evaluation": {
          "$ref": "#/$defs/taskEvaluation"
        },
        "label": {
          "enum": [
            "success",
            "failure",
            "unanswered"
          ]
        },
        "stopReason": {
          "type": "string",
          "minLength": 1
        },
        "spend": {
          "$ref": "#/$defs/spend"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "id",
        "runId",
        "taskId",
        "s0Hash",
        "condition",
        "attempt",
        "messages",
        "reasoning",
        "steps",
        "finalAnswer",
        "artifacts",
        "evaluation",
        "label",
        "stopReason",
        "spend",
        "idempotencyKey"
      ],
      "additionalProperties": false
    },
    "analystExclusion": {
      "description": "Why an analyst emitted no patch. Every value is a counted outcome of the run, never a hidden failure: `exhausted` ran out of rounds or budget, `tool-failure` lost a host tool, `unsupported-artifacts` could not see the outputs it needed, `already-correct` found the untouched output already passing, `no-causal-explanation` repaired without citing the span that failed, and `evaluator-disagrees` claimed a repair the evaluator refused.",
      "enum": [
        "exhausted",
        "tool-failure",
        "unsupported-artifacts",
        "already-correct",
        "no-causal-explanation",
        "evaluator-disagrees"
      ]
    },
    "analystRepair": {
      "type": "object",
      "properties": {
        "attempts": {
          "$ref": "#/$defs/count"
        },
        "evaluation": {
          "$ref": "#/$defs/taskEvaluation"
        }
      },
      "required": [
        "attempts",
        "evaluation"
      ],
      "additionalProperties": false
    },
    "analystResult": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/sha256"
        },
        "runId": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "enum": [
            "success",
            "error"
          ]
        },
        "rolloutId": {
          "$ref": "#/$defs/sha256"
        },
        "s0Hash": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "patch",
            "excluded"
          ]
        },
        "exclusion": {
          "anyOf": [
            {
              "$ref": "#/$defs/analystExclusion"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnosis": {
          "type": "string"
        },
        "repair": {
          "anyOf": [
            {
              "$ref": "#/$defs/analystRepair"
            },
            {
              "type": "null"
            }
          ]
        },
        "patchId": {
          "type": [
            "string",
            "null"
          ]
        },
        "spend": {
          "$ref": "#/$defs/spend"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "id",
        "runId",
        "role",
        "rolloutId",
        "s0Hash",
        "status",
        "exclusion",
        "diagnosis",
        "repair",
        "patchId",
        "spend",
        "idempotencyKey"
      ],
      "additionalProperties": false
    },
    "createFileOperation": {
      "type": "object",
      "properties": {
        "op": {
          "const": "create_file"
        },
        "path": {
          "$ref": "#/$defs/skillPath"
        },
        "group": {
          "$ref": "#/$defs/id"
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "path",
        "group",
        "content"
      ],
      "additionalProperties": false
    },
    "insertOperation": {
      "type": "object",
      "properties": {
        "op": {
          "enum": [
            "insert_before",
            "insert_after"
          ]
        },
        "path": {
          "$ref": "#/$defs/skillPath"
        },
        "group": {
          "$ref": "#/$defs/id"
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "path",
        "group",
        "anchor",
        "content"
      ],
      "additionalProperties": false
    },
    "sectionOperation": {
      "type": "object",
      "properties": {
        "op": {
          "enum": [
            "replace_section",
            "delete_section"
          ]
        },
        "path": {
          "$ref": "#/$defs/skillPath"
        },
        "group": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "op",
        "path",
        "group",
        "from",
        "to",
        "content"
      ],
      "additionalProperties": false
    },
    "patchOperation": {
      "anyOf": [
        {
          "$ref": "#/$defs/createFileOperation"
        },
        {
          "$ref": "#/$defs/insertOperation"
        },
        {
          "$ref": "#/$defs/sectionOperation"
        }
      ]
    },
    "patchValidation": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "pending",
            "compiled",
            "withheld",
            "refused"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace2SkillIssue"
          }
        }
      },
      "required": [
        "state",
        "issues"
      ],
      "additionalProperties": false
    },
    "authoredPatch": {
      "description": "A directory patch as a role writes it: the edits and the reason for them. Identity, run, frozen base hash, provenance and support are sealed by the dispatcher from what it already knows, so nothing here asks a model for a receipt it cannot compute.",
      "type": "object",
      "properties": {
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/patchOperation"
          }
        }
      },
      "required": [
        "reasoning",
        "operations"
      ],
      "additionalProperties": false
    },
    "skillPatch": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/sha256"
        },
        "runId": {
          "$ref": "#/$defs/sha256"
        },
        "baseHash": {
          "$ref": "#/$defs/sha256"
        },
        "sourceRolloutIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "sourcePatchIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "supportCount": {
          "$ref": "#/$defs/count"
        },
        "reasoning": {
          "type": "string"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/patchOperation"
          }
        },
        "changelog": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation": {
          "$ref": "#/$defs/patchValidation"
        }
      },
      "required": [
        "id",
        "runId",
        "baseHash",
        "sourceRolloutIds",
        "sourcePatchIds",
        "supportCount",
        "reasoning",
        "operations",
        "changelog",
        "validation"
      ],
      "additionalProperties": false
    },
    "successAnalysis": {
      "description": "What one successful trajectory taught, in a single pass. The patterns cite the steps they were read from, so a claim with no step behind it is visible; a null patch says the directory already covers this trajectory.",
      "type": "object",
      "properties": {
        "patterns": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "behavior": {
                "type": "string",
                "minLength": 1
              },
              "evidenceStepIndexes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/count"
                }
              }
            },
            "required": [
              "behavior",
              "evidenceStepIndexes"
            ],
            "additionalProperties": false
          }
        },
        "patch": {
          "anyOf": [
            {
              "$ref": "#/$defs/authoredPatch"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "patterns",
        "patch",
        "reasoning"
      ],
      "additionalProperties": false
    },
    "errorDiagnosis": {
      "description": "An error analyst's terminal explanation of one failure. Every member is a claim the run can check against what it recorded: the trace spans that failed, the mismatch, the repair that was made in the sandbox, the evaluation attempt that passed over it, and why the guidance generalizes beyond this instance. An empty span list is storable on purpose \u2014 a repair nobody can trace to a failure is a counted exclusion, not a refused write.",
      "type": "object",
      "properties": {
        "failingStepIndexes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/count"
          }
        },
        "mismatch": {
          "type": "string"
        },
        "repair": {
          "type": "string"
        },
        "evaluation": {
          "$ref": "#/$defs/count"
        },
        "generalization": {
          "type": "string"
        }
      },
      "required": [
        "failingStepIndexes",
        "mismatch",
        "repair",
        "evaluation",
        "generalization"
      ],
      "additionalProperties": false
    },
    "errorProposal": {
      "description": "The terminal call an error analyst makes: the patch it wants stored and the diagnosis that has to hold for it to be stored at all.",
      "type": "object",
      "properties": {
        "patch": {
          "$ref": "#/$defs/authoredPatch"
        },
        "diagnosis": {
          "$ref": "#/$defs/errorDiagnosis"
        }
      },
      "required": [
        "patch",
        "diagnosis"
      ],
      "additionalProperties": false
    },
    "mergeChangelogAction": {
      "description": "What one merge decision did with a proposal. `kept` carries an edit through unchanged, `merged` folds several proposals of one insight into a single edit, `routed-to-references` moves guidance out of the root page into a reference file, and `discarded` drops a proposal that disagreed with the one that was kept. A decision is always one of these four, so a merge cannot quietly lose an edit.",
      "enum": [
        "kept",
        "merged",
        "routed-to-references",
        "discarded"
      ]
    },
    "mergeChangelogEntry": {
      "description": "One decision of one merge group, naming the input patches it acted on. The named ids must belong to the group, so a merge cannot claim provenance it was never given.",
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/mergeChangelogAction"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "sourcePatchIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "required": [
        "action",
        "detail",
        "sourcePatchIds"
      ],
      "additionalProperties": false
    },
    "mergeOutput": {
      "description": "What one merge group returns: a single directory patch over the frozen directory and the decision log that explains it. Identity, run, base hash, provenance and support are receipts the run computes from the group it dispatched, so nothing here asks the operator for a number it cannot know.",
      "type": "object",
      "properties": {
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/patchOperation"
          }
        },
        "changelog": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/mergeChangelogEntry"
          }
        }
      },
      "required": [
        "reasoning",
        "operations",
        "changelog"
      ],
      "additionalProperties": false
    },
    "mergeReport": {
      "type": "object",
      "properties": {
