          "$ref": "#/$defs/count"
        },
        "skips": {
          "$ref": "#/$defs/count"
        },
        "leakage": {
          "$ref": "#/$defs/count"
        },
        "eligible": {
          "type": "boolean"
        },
        "policyVersion": {
          "$ref": "#/$defs/id"
        },
        "expectedHead": {
          "$ref": "#/$defs/skillHead"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace2SkillIssue"
          }
        }
      },
      "required": [
        "id",
        "runId",
        "scopeKey",
        "baselineBundleId",
        "candidateBundleId",
        "executorIdentityId",
        "split",
        "testHash",
        "results",
        "meanDelta",
        "costDelta",
        "failures",
        "skips",
        "leakage",
        "eligible",
        "policyVersion",
        "expectedHead",
        "issues"
      ],
      "additionalProperties": false
    },
    "skillHeadRow": {
      "type": "object",
      "properties": {
        "scopeKey": {
          "$ref": "#/$defs/id"
        },
        "head": {
          "$ref": "#/$defs/skillHead"
        }
      },
      "required": [
        "scopeKey",
        "head"
      ],
      "additionalProperties": false
    },
    "evaluationPolicy": {
      "description": "The gate a held-out evaluation is judged against. Its canonical digest is the `policyVersion` an evaluation records and an activation registration must name, so a candidate evaluated under one gate can never be promoted under another.",
      "type": "object",
      "properties": {
        "primaryMetric": {
          "description": "The quantity eligibility is decided on. Mean paired score over the held-out split is the only one this package computes.",
          "const": "mean-score"
        },
        "regressionTolerance": {
          "description": "How far one held-out task may score below the baseline before the candidate is refused, whatever the mean says.",
          "type": "number",
          "minimum": 0
        },
        "minAnsweredCoverage": {
          "description": "The share of held-out tasks the candidate must actually answer; a candidate that wins by refusing to answer is not an improvement.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "costCeiling": {
          "description": "The token ceiling the candidate's held-out pass may not exceed, or null where the host sets no bound.",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "primaryMetric",
        "regressionTolerance",
        "minAnsweredCoverage",
        "costCeiling"
      ],
      "additionalProperties": false
    },
    "activationEvent": {
      "description": "One attempt to move the active directory of a scope, recorded whether it applied or was refused. It is stored beside the evaluations of its scope and told apart from them by `kind`; a refusal carries the issues that stopped it and leaves the prior head exactly where it was. A `promote` names the candidate and the held-out evaluation that made it eligible; a `rollback` reinstates a directory that was active before and may name neither, because a starting directory a host imported was never a candidate.",
      "type": "object",
      "properties": {
        "kind": {
          "const": "activation"
        },
        "id": {
          "$ref": "#/$defs/sha256"
        },
        "scopeKey": {
          "$ref": "#/$defs/id"
        },
        "candidateId": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "bundleId": {
          "$ref": "#/$defs/sha256"
        },
        "evaluationId": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "enum": [
            "promote",
            "rollback"
          ]
        },
        "outcome": {
          "enum": [
            "activated",
            "refused"
          ]
        },
        "actor": {
          "$ref": "#/$defs/id"
        },
        "previousHead": {
          "$ref": "#/$defs/skillHead"
        },
        "nextHead": {
          "$ref": "#/$defs/skillHead"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace2SkillIssue"
          }
        }
      },
      "required": [
        "kind",
        "id",
        "scopeKey",
        "candidateId",
        "bundleId",
        "evaluationId",
        "action",
        "outcome",
        "actor",
        "previousHead",
        "nextHead",
        "issues"
      ],
      "additionalProperties": false,
      "$query": {
        "$and": [
          {
            "$or": [
              {
                "$ne": [
                  "$.action",
                  "promote"
                ]
              },
              {
                "$and": [
                  {
                    "$ne": [
                      "$.candidateId",
                      null
                    ]
                  },
                  {
                    "$ne": [
                      "$.evaluationId",
                      null
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "evaluationRow": {
      "description": "What the evaluations collection holds: a held-out evaluation, or an activation event that names one. Both shapes are closed and only the event carries `kind`, so a reader tells them apart without a second collection.",
      "oneOf": [
        {
          "$ref": "#/$defs/skillEvaluation"
        },
        {
          "$ref": "#/$defs/activationEvent"
        }
      ]
    },
    "trace2SkillPromptRole": {
      "description": "The five roles a run addresses. A pack that names anything else is not one of this package's prompts.",
      "enum": [
        "draft",
        "executor",
        "success-analyst",
        "error-analyst",
        "merge"
      ]
    },
    "trace2SkillPromptVariable": {
      "description": "One declared slot of a user template: the closed schema its value must satisfy, and whether it is substituted as text or as JSON.",
      "type": "object",
      "properties": {
        "schema": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "render": {
          "enum": [
            "text",
            "json"
          ]
        }
      },
      "required": [
        "schema",
        "render"
      ],
      "additionalProperties": false
    },
    "trace2SkillPromptVariables": {
      "description": "Every slot a pack may use, by name. A name the template uses and this map does not declare is refused, and so is a declaration the template never uses.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "not": {
          "enum": [
            "prototype",
            "constructor",
            "__proto__"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/trace2SkillPromptVariable"
      }
    },
    "trace2SkillPromptPack": {
      "description": "A role prompt as it is authored: static system instructions and one user template. The system half may carry no placeholder, so nothing a run substitutes can reach the instructions.",
      "type": "object",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "$ref": "#/$defs/trace2SkillPromptRole"
            }
          },
          "required": [
            "id",
            "version",
            "role"
          ],
          "additionalProperties": false
        },
        "system": {
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "content"
          ],
          "additionalProperties": false
        },
        "user": {
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "content"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "meta",
        "system",
        "user"
      ],
      "additionalProperties": false
    },
    "trace2SkillPromptArtifact": {
      "description": "A compiled pack: the source it was built from, the closed variable contract, the stylesheet the user half renders through, and the revision that IS the role's prompt version. Moving any source byte moves the revision, which moves every idempotency key that named it.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "role": {
          "$ref": "#/$defs/trace2SkillPromptRole"
        },
        "revision": {
          "$ref": "#/$defs/sha256"
        },
        "policyVersion": {
          "const": "trace2skill-jtlt-v1"
        },
        "sourceDigest": {
          "$ref": "#/$defs/sha256"
        },
        "pack": {
          "$ref": "#/$defs/trace2SkillPromptPack"
        },
        "variables": {
          "$ref": "#/$defs/trace2SkillPromptVariables"
        },
        "variableSchema": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "outputSchema": {
          "description": "What the role's answer must satisfy, or `true` where the role answers as an agent and no structured schema constrains it.",
          "type": [
            "object",
            "boolean"
          ]
        },
        "userStylesheet": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "role",
        "revision",
        "policyVersion",
        "sourceDigest",
        "pack",
        "variables",
        "variableSchema",
        "outputSchema",
        "userStylesheet"
      ],
      "additionalProperties": false
    },
    "trace2SkillPromptCatalog": {
      "description": "The generated artifact set an installed consumer reads instead of a source directory: one compiled pack per role, in role order.",
      "type": "object",
      "properties": {
        "document": {
          "const": "trace2skill-prompts"
        },
        "policyVersion": {
          "const": "trace2skill-jtlt-v1"
        },
        "revision": {
          "$ref": "#/$defs/sha256"
        },
        "prompts": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/trace2SkillPromptArtifact"
          }
        }
      },
      "required": [
        "document",
        "policyVersion",
        "revision",
        "prompts"
      ],
      "additionalProperties": false
    }
  }
}
