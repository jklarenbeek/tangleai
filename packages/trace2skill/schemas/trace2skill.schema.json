        },
        "duplicates": {
          "$ref": "#/$defs/count"
        },
        "withheld": {
          "$ref": "#/$defs/count"
        },
        "successSupport": {
          "$ref": "#/$defs/count"
        },
        "errorSupport": {
          "$ref": "#/$defs/count"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace2SkillIssue"
          }
        }
      },
      "required": [
        "unique",
        "duplicates",
        "withheld",
        "successSupport",
        "errorSupport",
        "issues"
      ],
      "additionalProperties": false
    },
    "mergeNode": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "runId": {
          "$ref": "#/$defs/sha256"
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "groupIndex": {
          "type": "integer",
          "minimum": 1
        },
        "inputPatchIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "outputPatchId": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseHash": {
          "$ref": "#/$defs/sha256"
        },
        "supportCount": {
          "$ref": "#/$defs/count"
        },
        "report": {
          "$ref": "#/$defs/mergeReport"
        },
        "spend": {
          "$ref": "#/$defs/spend"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "id",
        "runId",
        "level",
        "groupIndex",
        "inputPatchIds",
        "outputPatchId",
        "baseHash",
        "supportCount",
        "report",
        "spend",
        "idempotencyKey"
      ],
      "additionalProperties": false
    },
    "candidateCheck": {
      "type": "object",
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace2SkillIssue"
          }
        }
      },
      "required": [
        "valid",
        "issues"
      ],
      "additionalProperties": false
    },
    "skillCandidate": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/sha256"
        },
        "runId": {
          "$ref": "#/$defs/sha256"
        },
        "scopeKey": {
          "$ref": "#/$defs/id"
        },
        "finalPatchId": {
          "$ref": "#/$defs/id"
        },
        "bundleId": {
          "$ref": "#/$defs/sha256"
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "structural": {
          "$ref": "#/$defs/candidateCheck"
        },
        "semantic": {
          "$ref": "#/$defs/candidateCheck"
        },
        "diffSummary": {
          "type": "object",
          "properties": {
            "filesAdded": {
              "$ref": "#/$defs/count"
            },
            "filesChanged": {
              "$ref": "#/$defs/count"
            },
            "linesAdded": {
              "$ref": "#/$defs/count"
            },
            "linesRemoved": {
              "$ref": "#/$defs/count"
            }
          },
          "required": [
            "filesAdded",
            "filesChanged",
            "linesAdded",
            "linesRemoved"
          ],
          "additionalProperties": false
        },
        "churn": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "runId",
        "scopeKey",
        "finalPatchId",
        "bundleId",
        "parentId",
        "structural",
        "semantic",
        "diffSummary",
        "churn"
      ],
      "additionalProperties": false
    },
    "heldOutResult": {
      "type": "object",
      "properties": {
        "taskId": {
          "$ref": "#/$defs/id"
        },
        "baselineScore": {
          "type": "number"
        },
        "candidateScore": {
          "type": "number"
        },
        "label": {
          "enum": [
            "success",
            "failure",
            "unanswered"
          ]
        }
      },
      "required": [
        "taskId",
        "baselineScore",
        "candidateScore",
        "label"
      ],
      "additionalProperties": false
    },
    "skillEvaluation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/sha256"
        },
        "runId": {
          "$ref": "#/$defs/sha256"
        },
        "scopeKey": {
          "$ref": "#/$defs/id"
        },
        "baselineBundleId": {
          "$ref": "#/$defs/sha256"
        },
        "candidateBundleId": {
          "$ref": "#/$defs/sha256"
        },
        "executorIdentityId": {
          "$ref": "#/$defs/id"
        },
        "split": {
          "const": "test"
        },
        "testHash": {
          "$ref": "#/$defs/sha256"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/heldOutResult"
          }
        },
        "meanDelta": {
          "type": "number"
        },
        "costDelta": {
          "type": [
            "number",
            "null"
          ]
        },
