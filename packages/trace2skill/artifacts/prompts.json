                "enum": [
                  "replace_section",
                  "delete_section"
                ]
              },
              "path": {
                "$ref": "#/$defs/skillPath"
              },
              "group": {
                "$ref": "#/$defs/id"
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "content": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "op",
              "path",
              "group",
              "from",
              "to",
              "content"
            ],
            "additionalProperties": false
          },
          "mergeChangelogEntry": {
            "description": "One decision of one merge group, naming the input patches it acted on. The named ids must belong to the group, so a merge cannot claim provenance it was never given.",
            "type": "object",
            "properties": {
              "action": {
                "$ref": "#/$defs/mergeChangelogAction"
              },
              "detail": {
                "type": "string",
                "minLength": 1
              },
              "sourcePatchIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            },
            "required": [
              "action",
              "detail",
              "sourcePatchIds"
            ],
            "additionalProperties": false
          },
          "mergeChangelogAction": {
            "description": "What one merge decision did with a proposal. `kept` carries an edit through unchanged, `merged` folds several proposals of one insight into a single edit, `routed-to-references` moves guidance out of the root page into a reference file, and `discarded` drops a proposal that disagreed with the one that was kept. A decision is always one of these four, so a merge cannot quietly lose an edit.",
            "enum": [
              "kept",
              "merged",
              "routed-to-references",
              "discarded"
            ]
          }
