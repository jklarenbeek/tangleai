        "description": "The terminal call an error analyst makes: the patch it wants stored and the diagnosis that has to hold for it to be stored at all.",
        "type": "object",
        "properties": {
          "patch": {
            "$ref": "#/$defs/authoredPatch"
          },
          "diagnosis": {
            "$ref": "#/$defs/errorDiagnosis"
          }
        },
        "required": [
