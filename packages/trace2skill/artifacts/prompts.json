    {
      "id": "merge",
      "role": "merge",
      "policyVersion": "trace2skill-jtlt-v1",
      "sourceDigest": "62dcc473480a96cdb96e0cf5f184edffaedce90a44209a5f766c498536eb55be",
      "pack": {
        "meta": {
          "id": "merge",
          "version": "1.0.0",
          "role": "merge"
        },
        "system": {
          "content": "You consolidate several directory patches, all written against the SAME\nfrozen skill directory, into ONE patch over that same directory.\n\nKeep every distinct insight the group supports. Fold proposals that say the\nsame thing into a single edit, and where two proposals of one insight\ndisagree, keep the one that states it best and discard the other. Never\nedit a directory a peer has already changed: every anchor you use is text\nof the frozen directory as it is given to you.\n\nReturn the merged patch and one changelog entry per decision, each naming\nthe patch identifiers it acted on. How many distinct trajectories support a\nproposal is evidence about how general it is, not a threshold: a lone\ninsight that is clearly reusable stays."
        },
        "user": {
          "content": "{{evidence}}"
        }
      },
      "variables": {
        "evidence": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "render": "text"
        }
      },
      "variableSchema": {
        "type": "object",
        "properties": {
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "evidence"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$id": "https://tangleai.dev/schemas/trace2skill/mergeOutput",
        "description": "What one merge group returns: a single directory patch over the frozen directory and the decision log that explains it. Identity, run, base hash, provenance and support are receipts the run computes from the group it dispatched, so nothing here asks the operator for a number it cannot know.",
        "type": "object",
        "properties": {
          "reasoning": {
            "type": "string",
            "minLength": 1
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "$ref": "#/$defs/patchOperation"
            }
          },
          "changelog": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "$ref": "#/$defs/mergeChangelogEntry"
            }
          }
        },
        "required": [
          "reasoning",
          "operations",
          "changelog"
        ],
        "additionalProperties": false,
        "$defs": {
          "patchOperation": {
            "anyOf": [
              {
                "$ref": "#/$defs/createFileOperation"
              },
              {
                "$ref": "#/$defs/insertOperation"
              },
              {
                "$ref": "#/$defs/sectionOperation"
              }
            ]
          },
          "createFileOperation": {
            "type": "object",
            "properties": {
              "op": {
                "const": "create_file"
              },
              "path": {
                "$ref": "#/$defs/skillPath"
              },
              "group": {
                "$ref": "#/$defs/id"
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "op",
              "path",
              "group",
              "content"
            ],
            "additionalProperties": false
          },
          "skillPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/-]*$"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "insertOperation": {
            "type": "object",
            "properties": {
              "op": {
                "enum": [
                  "insert_before",
                  "insert_after"
                ]
              },
              "path": {
                "$ref": "#/$defs/skillPath"
              },
              "group": {
                "$ref": "#/$defs/id"
              },
              "anchor": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "op",
              "path",
              "group",
              "anchor",
              "content"
            ],
            "additionalProperties": false
          },
          "sectionOperation": {
