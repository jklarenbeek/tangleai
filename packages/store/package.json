{
  "name": "@tangleai/store",
  "version": "0.45.1",
  "description": "Tangle AI persistence — the MemoryStore contract over SQLite via @jarenjs/db, plus the run/event log the DAG surface reads",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model.ts",
    "./db": "./src/db.ts",
    "./memory-store": "./src/memory-store.ts",
    "./runs": "./src/runs.ts",
    "./package.json": "./package.json",
    "./mas-store": "./src/mas-store.ts",
    "./mas-jobs": "./src/mas-jobs.ts",
    "./ledger-storage": "./src/ledger-storage.ts",
    "./outcome-store": "./src/outcome-store.ts",
    "./temporal-store": "./src/temporal-store.ts",
    "./consolidation-store": "./src/consolidation-store.ts",
    "./trace2skill-store": "./src/trace2skill-store.ts",
    "./evolve-store": "./src/evolve-store.ts",
    "./evolve-effects": "./src/evolve-effects.ts",
    "./forecast-store": "./src/forecast-store.ts",
    "./grounding-store": "./src/grounding-store.ts",
    "./lightrag-store": "./src/lightrag-store.ts",
    "./corpus-promotion": "./src/corpus-promotion.ts",
    "./gc": "./src/gc.ts",
    "./research-store": "./src/research-store.ts",
    "./experiential-store": "./src/experiential-store.ts",
    "./experiential-jobs": "./src/experiential-jobs.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@tangleai/documents": "0.45.1",
    "@tangleai/core": "0.45.1",
    "@tangleai/config": "0.45.1",
    "@jarenjs/db": "0.183.1",
    "@jarenjs/validate": "0.183.1",
    "@tangleai/mas": "0.45.1",
    "@jarenjs/core": "0.183.1",
    "@jarenjs/linq": "0.183.1",
    "@tangleai/memory": "0.45.1",
    "@tangleai/outcomes": "0.45.1",
    "@tangleai/trace2skill": "0.45.1",
    "@tangleai/evolve": "0.45.1",
    "@tangleai/hera": "0.45.1",
    "@tangleai/forecast": "0.45.1",
    "@tangleai/grounding": "0.45.1",
    "@tangleai/lightrag": "0.45.1",
    "@tangleai/trading": "0.45.1",
    "@tangleai/research": "0.45.1",
    "@tangleai/experiential": "0.45.1"
  },
  "private": false,
  "types": "./src/index.ts",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "schemas/**/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/store"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
