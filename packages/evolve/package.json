{
  "name": "@tangleai/evolve",
  "version": "0.30.1",
  "description": "Isolated propose, apply, gate, measure and decide experiments over a repository, with human merge authority",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.gen.ts",
    "./contract": "./src/contract.ts",
    "./schemas/evolve-contract": "./schemas/evolve.contract.json",
    "./lifecycle": "./src/lifecycle/index.ts",
    "./schemas/evolve": "./schemas/evolve.schema.json",
    "./host": "./src/host/index.ts",
    "./adapters/experiment": "./src/adapters/experiment.ts",
    "./schemas/experiment-adapter": "./schemas/experiment-adapter.schema.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/contract": "0.91.4",
    "@jarenjs/core": "0.91.4",
    "@jarenjs/json": "0.91.4",
    "@jarenjs/validate": "0.91.4",
    "@tangleai/config": "^0.30.1",
    "@tangleai/context": "^0.30.1",
    "@tangleai/core": "^0.30.1",
    "@tangleai/mas": "^0.30.1",
    "@tangleai/outcomes": "^0.30.1"
  },
  "private": false,
  "types": "./src/index.ts",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "schemas/**/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/**/*.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/evolve"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
