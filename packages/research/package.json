{
  "name": "@tangleai/research",
  "version": "0.38.0",
  "description": "Immutable research contracts, artifact provenance and atomic lifecycle storage",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.gen.ts",
    "./schemas/research": "./schemas/research.schema.json",
    "./package.json": "./package.json",
    "./schemas/lesson": "./schemas/lesson.schema.json",
    "./schemas/lesson-validation-run": "./schemas/lesson-validation-run.schema.json",
    "./schemas/lesson-set": "./schemas/lesson-set.schema.json",
    "./schemas/lesson-injection": "./schemas/lesson-injection.schema.json",
    "./schemas/decay-hypothesis": "./schemas/decay-hypothesis.schema.json"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/core": "0.91.4",
    "@jarenjs/json": "0.91.4",
    "@jarenjs/validate": "0.91.4",
    "@jarenjs/contract": "0.91.4",
    "@tangleai/mas": "^0.38.0",
    "@tangleai/context": "^0.38.0",
    "@tangleai/gmpl": "^0.38.0",
    "@tangleai/config": "^0.38.0",
    "@tangleai/documents": "^0.38.0",
    "@tangleai/search": "^0.38.0",
    "@tangleai/agents": "^0.38.0",
    "@tangleai/models": "^0.38.0",
    "@tangleai/evolve": "^0.38.0",
    "@jarenjs/md": "0.91.4",
    "@tangleai/trace2skill": "^0.38.0",
    "@tangleai/outcomes": "^0.38.0"
  },
  "private": false,
  "types": "./src/index.ts",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "schemas/**/*.json",
    "artifacts/**/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/**/*.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/research"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
