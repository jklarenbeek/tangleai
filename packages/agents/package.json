{
  "name": "@tangleai/agents",
  "version": "0.30.1",
  "description": "Validated tools, bounded agents, action programs, recursive execution and guarded refinement.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./toolbox": "./src/toolbox.ts",
    "./agent": "./src/agent.ts",
    "./program": "./src/program.ts",
    "./recursive": "./src/recursive.ts",
    "./refine": "./src/refine.ts",
    "./schemas/program": "./src/schemas/program.ts",
    "./program-result": "./src/program-result.ts",
    "./program-session": "./src/program-session.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/core": "0.91.4",
    "@jarenjs/validate": "0.91.4",
    "@tangleai/models": "^0.30.1",
    "@tangleai/context": "^0.30.1",
    "@jarenjs/contract": "0.91.4"
  },
  "private": false,
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/agents"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
