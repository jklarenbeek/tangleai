{
  "name": "@tangleai/agents",
  "version": "0.21.0",
  "description": "Validated tools, bounded agents, action programs, recursive execution and guarded refinement.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./toolbox": {
      "types": "./dist/types/toolbox.d.ts",
      "default": "./src/toolbox.js"
    },
    "./agent": {
      "types": "./dist/types/agent.d.ts",
      "default": "./src/agent.js"
    },
    "./program": {
      "types": "./dist/types/program.d.ts",
      "default": "./src/program.js"
    },
    "./recursive": {
      "types": "./dist/types/recursive.d.ts",
      "default": "./src/recursive.js"
    },
    "./refine": {
      "types": "./dist/types/refine.d.ts",
      "default": "./src/refine.js"
    },
    "./schemas/program": {
      "types": "./dist/types/schemas/program.d.ts",
      "default": "./src/schemas/program.js"
    },
    "./program-result": {
      "types": "./dist/types/program-result.d.ts",
      "default": "./src/program-result.js"
    },
    "./program-session": {
      "types": "./dist/types/program-session.d.ts",
      "default": "./src/program-session.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/core": "0.84.0",
    "@jarenjs/validate": "0.84.0",
    "@tangleai/models": "^0.21.0",
    "@tangleai/context": "^0.21.0",
    "@jarenjs/contract": "0.84.0"
  },
  "private": false,
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/agents"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
