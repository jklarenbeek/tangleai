{
  "name": "@tangleai/jaren",
  "version": "0.27.3",
  "description": "Grammar authors and revision-checked editor adapters over public Jaren APIs.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./studio": "./src/studio.ts",
    "./data": "./src/data.ts",
    "./flow": "./src/flow.ts",
    "./stylesheet": "./src/stylesheet.ts",
    "./spatial": "./src/spatial.ts",
    "./geo-tools": "./src/geo-tools.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/core": "0.90.6",
    "@jarenjs/validate": "0.90.6",
    "@jarenjs/json": "0.90.6",
    "@jarenjs/app": "0.90.6",
    "@jarenjs/flow": "0.90.6",
    "@jarenjs/db": "0.90.6",
    "@jarenjs/studio": "0.90.6",
    "@jarenjs/linq": "0.90.6",
    "@tangleai/models": "^0.27.3",
    "@tangleai/context": "^0.27.3",
    "@tangleai/agents": "^0.27.3"
  },
  "private": false,
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/**/*.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/jaren"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
