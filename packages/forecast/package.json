{
  "name": "@tangleai/forecast",
  "version": "0.38.0",
  "description": "Cutoff-audited forecasting checkpoints and question-local harness lifecycle",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.gen.ts",
    "./schemas/forecast": "./schemas/forecast.schema.json",
    "./package.json": "./package.json",
    "./schemas/outcome-adapter": "./schemas/outcome-adapter.schema.json",
    "./contract": "./src/contract.ts",
    "./schemas/contract": "./schemas/forecast.contract.json"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/core": "0.91.4",
    "@jarenjs/json": "0.91.4",
    "@jarenjs/validate": "0.91.4",
    "@tangleai/outcomes": "^0.38.0",
    "@tangleai/agents": "^0.38.0",
    "@tangleai/models": "^0.38.0",
    "@tangleai/context": "^0.38.0",
    "@tangleai/search": "^0.38.0",
    "@tangleai/documents": "^0.38.0",
    "@tangleai/mas": "^0.38.0",
    "@jarenjs/contract": "0.91.4"
  },
  "private": false,
  "types": "./src/index.ts",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "schemas/**/*.json",
