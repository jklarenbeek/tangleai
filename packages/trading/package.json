{
  "name": "@tangleai/trading",
  "version": "0.40.0",
  "description": "Point-in-time trading contracts and atomic simulated portfolio persistence",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.gen.ts",
    "./schemas/trading": "./schemas/trading.schema.json",
    "./package.json": "./package.json",
    "./artifacts": "./artifacts/catalog.json"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/core": "0.91.4",
    "@jarenjs/json": "0.91.4",
    "@jarenjs/validate": "0.91.4",
    "@tangleai/mas": "^0.40.0",
    "@tangleai/gmpl": "^0.40.0"
  },
  "private": false,
  "types": "./src/index.ts",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "schemas/**/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/**/*.md",
    "artifacts/**/*.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/trading"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
