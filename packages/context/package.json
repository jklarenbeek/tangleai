{
  "name": "@tangleai/context",
  "version": "0.29.5",
  "description": "Evidence-backed ledgers, bounded environments, recall, retention and storage contracts.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./recall": "./src/recall.ts",
    "./ledger": "./src/ledger.ts",
    "./environment": "./src/environment.ts",
    "./storage/memory": "./src/storage/memory.ts",
    "./schemas/ledger": "./src/schemas/ledger.ts",
    "./schemas/patch": "./src/schemas/patch.ts",
    "./evidence": "./src/evidence.ts",
    "./retention": "./src/retention.ts",
    "./schemas/evidence": "./src/schemas/evidence.ts",
    "./archive": "./src/archive.ts",
    "./package.json": "./package.json",
    "./storage/slot": "./src/storage/slot.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/core": "0.90.6",
    "@jarenjs/validate": "0.90.6",
    "@tangleai/models": "^0.29.5"
  },
  "private": false,
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/context"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
