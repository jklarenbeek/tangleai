{
  "name": "@tangleai/context",
  "version": "0.21.1",
  "description": "Evidence-backed ledgers, bounded environments, recall, retention and storage contracts.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.js"
    },
    "./recall": {
      "types": "./dist/types/recall.d.ts",
      "default": "./src/recall.js"
    },
    "./ledger": {
      "types": "./dist/types/ledger.d.ts",
      "default": "./src/ledger.js"
    },
    "./environment": {
      "types": "./dist/types/environment.d.ts",
      "default": "./src/environment.js"
    },
    "./storage/memory": {
      "types": "./dist/types/storage/memory.d.ts",
      "default": "./src/storage/memory.js"
    },
    "./schemas/ledger": {
      "types": "./dist/types/schemas/ledger.d.ts",
      "default": "./src/schemas/ledger.js"
    },
    "./schemas/patch": {
      "types": "./dist/types/schemas/patch.d.ts",
      "default": "./src/schemas/patch.js"
    },
    "./evidence": {
      "types": "./dist/types/evidence.d.ts",
      "default": "./src/evidence.js"
    },
    "./retention": {
      "types": "./dist/types/retention.d.ts",
      "default": "./src/retention.js"
    },
    "./schemas/evidence": {
      "types": "./dist/types/schemas/evidence.d.ts",
      "default": "./src/schemas/evidence.js"
    },
    "./archive": {
      "types": "./dist/types/archive.d.ts",
      "default": "./src/archive.js"
    },
    "./package.json": "./package.json",
    "./storage/slot": {
      "types": "./dist/types/storage/slot.d.ts",
      "default": "./src/storage/slot.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/core": "0.84.3",
    "@jarenjs/validate": "0.84.3",
    "@tangleai/models": "^0.21.1"
  },
  "private": false,
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/context"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
