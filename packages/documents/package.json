{
  "name": "@tangleai/documents",
  "version": "0.23.0",
  "description": "Safe, versioned document ingestion and retrieval for TangleAI",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./chunking": "./src/chunking.ts",
    "./contracts": "./src/contracts.ts",
    "./extract": "./src/extract.ts",
    "./fetch": "./src/fetch.ts",
    "./ingest": "./src/ingest.ts",
    "./retrieval": "./src/retrieval.ts",
    "./url-policy": "./src/url-policy.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.0"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/core": "0.84.3",
    "@tangleai/core": "^0.23.0",
    "linkedom": "0.18.12",
    "unpdf": "1.6.2",
    "@tangleai/models": "^0.23.0",
    "@tangleai/context": "^0.23.0"
  },
  "private": false,
  "types": "./src/index.ts",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "schemas/**/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/documents"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
