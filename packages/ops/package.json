{
  "name": "@tangleai/ops",
  "version": "0.73.0",
  "description": "Tangle AI operations — a Jaren store's job queue and schedules served to the desktop through the job_queue contract.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./provider": "./src/provider.ts",
    "./registry": "./src/registry.ts",
    "./runtime": "./src/runtime.ts",
    "./events": "./src/events.ts",
    "./browser": "./src/browser.ts",
    "./supervisor": "./src/supervisor.ts",
    "./simulate": "./src/simulate.ts",
    "./product": "./src/product.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@tangleai/os": "0.73.0",
    "@jarenjs/core": "0.226.0",
    "@jarenjs/contract": "0.226.0",
    "@jarenjs/db": "0.226.0",
    "@jarenjs/locales": "0.226.0"
  },
  "private": false,
  "types": "./src/index.ts",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "schemas/**/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/ops"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
