{
  "name": "@tangleai/lightrag",
  "version": "0.44.0",
  "description": "Evidence-bound entity and relation projections for measured graph retrieval",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.gen.ts",
    "./schemas/lightrag": "./schemas/lightrag.schema.json",
    "./package.json": "./package.json",
    "./artifacts": "./artifacts/prompts.json"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "dependencies": {
    "@jarenjs/core": "0.176.11",
    "@jarenjs/json": "0.176.11",
    "@jarenjs/josl": "0.176.11",
    "@jarenjs/validate": "0.176.11",
    "@jarenjs/formats": "0.176.11",
    "@tangleai/core": "^0.44.0",
    "@tangleai/models": "^0.44.0",
    "@tangleai/context": "^0.44.0",
    "@tangleai/agents": "^0.44.0",
    "@tangleai/documents": "^0.44.0",
    "@tangleai/outcomes": "^0.44.0"
  },
  "private": false,
  "types": "./src/index.ts",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "schemas/**/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/**/*.md",
    "artifacts/**/*.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "packages/lightrag"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
