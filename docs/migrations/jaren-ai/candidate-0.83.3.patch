-      : ranked;
-    const capped = typeof query.limit === 'number' ? kept.slice(0, query.limit) : kept;
-    return {
-      [member]: capped.map((entry) => entry.record),
-      scores: capped.map((entry) => entry.score),
-      skipped,
-      via,
-      ranking,
