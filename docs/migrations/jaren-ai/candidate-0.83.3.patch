-  const lines = ['flowchart LR'];
-  const seen = new Set();
-  for (const from of Object.keys(LOCATIONS)) {
-    for (const to of LOCATIONS[from].exits) {
-      const key = [from, to].sort().join('~');
-      if (seen.has(key)) continue;
-      seen.add(key);
-      lines.push(`  ${from}[${label(from)}] --- ${to}[${label(to)}]`);
-    }
-  }
-  return lines.join('\n');
-}
