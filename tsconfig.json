{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/build.ts",
    "examples/**/*.ts",
    "benchmark/*.ts",
    "benchmark/lib/**/*.ts",
    "benchmark/scripts/*.ts",
    "test/**/*.ts",
    "scripts/release/**/*.ts",
    "scripts/jaren-artifacts.ts",
    "components/*/src/**/*.ts"
  ]
}
