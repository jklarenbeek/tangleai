{
  "name": "tangleai",
  "version": "0.1.0",
  "private": true,
  "description": "Tangle AI — self-improving memory and retrieval for agents, built on the @jarenjs suite",
  "author": "Joham <jklarenbeek@gmail.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "benchmark"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "test:core": "node --test \"test/core/*.test.ts\"",
    "test:memory": "node --test \"test/memory/*.test.ts\"",
    "test:search": "node --test \"test/search/*.test.ts\"",
    "test:store": "node --test \"test/store/*.test.ts\"",
    "test:pipeline": "node --test \"test/pipeline/*.test.ts\"",
    "test:desktop": "node --test \"test/desktop/*.test.ts\"",
    "test:benchmark": "node --test \"test/benchmark/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "skeleton": "node examples/skeleton.ts",
    "desktop:ui": "bun build apps/desktop/src/ui/main.ts --outfile apps/desktop/public/app.js --format esm --target browser && cat node_modules/@jarenjs/charts/styles/charts.css node_modules/@jarenjs/mermaid/styles/mermaid.css node_modules/@jarenjs/md/styles/md.css > apps/desktop/public/vendor.css",
    "desktop": "npm run desktop:ui && node apps/desktop/src/main.ts",
    "desktop:compile": "bun scripts/compile-desktop.ts",
    "scraper": "bun apps/scraper/src/main.ts",
    "documents:benchmark": "bun scripts/benchmark-documents.ts",
    "benchmark:locomo:census": "node benchmark/locomo-census.ts",
    "benchmark:locomo:recall": "node benchmark/locomo-recall.ts",
    "benchmark:locomo:parity": "python3 benchmark/scripts/locomo-parity-fixtures.py",
    "documents:live-smoke": "bun scripts/live-openrouter-smoke.ts",
    "pages:build": "bun apps/pages/build.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@jarenjs/ai": "^0.49.2",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
