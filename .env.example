# OpenRouter credentials. Keep the real value only in .env.
OPENROUTER_AI_KEY=

# Models used by opt-in live evaluation and smoke scripts.
TANGLE_AI_PROVIDER=openrouter
# Only for ollama / lmstudio / custom (OpenRouter needs none).
TANGLE_AI_BASE_URL=
TANGLE_AI_MODEL=qwen/qwen3.8-flash
TANGLE_AI_MODEL_STRONG=qwen/qwen3.8-27b
TANGLE_AI_EMBEDDING_MODEL=baai/bge-m3

# Evaluation budgets (individual scripts may use a smaller bound).
TANGLE_AI_MAX_CALLS=200
TANGLE_AI_MAX_CONCURRENCY=4
TANGLE_AI_TRIALS=3
