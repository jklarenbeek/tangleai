{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangleai.dev/schemas/os/module.schema.json",
  "title": "Tangle OS module manifest",
  "description": "One module of the Tangle browser OS: what it is called, how it is hosted, the contracts it serves and needs, its stylesheet and its window.",
  "type": "object",
  "required": [
    "$module",
    "id",
    "version",
    "title",
    "host"
  ],
  "additionalProperties": false,
  "properties": {
    "$module": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "description": "Stable identifier, unique on a desktop."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "icon": {
      "$ref": "#/$defs/icon"
    },
    "category": {
      "enum": [
        "system",
        "productivity",
        "development",
        "data",
        "communication",
        "suite",
        "play",
        "custom"
      ]
    },
    "host": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "mount"
          ],
          "properties": {
            "kind": {
              "const": "shipped"
            },
            "mount": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$",
              "description": "The name of a component the host registered."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "app"
          ],
          "properties": {
            "kind": {
              "const": "document"
            },
            "app": {
              "type": "object",
              "description": "A jaren-app document, run in a sandboxed frame."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "origin"
            },
            "url": {
              "type": "string",
              "pattern": "^https?://",
              "description": "An application page on its own origin that connects with @tangleai/os/module."
            }
          }
        }
      ]
    },
    "provides": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "$contract",
          "id",
          "operations"
        ],
        "description": "A @jarenjs/contract document this module serves."
      }
    },
    "requires": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract"
        ],
        "properties": {
          "contract": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "styles": {
      "type": "string",
      "maxLength": 262144,
      "description": "CSS applied only inside this module's own frame or window."
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 160,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 120,
          "maximum": 4096
        },
        "minWidth": {
          "type": "integer",
          "minimum": 120,
          "maximum": 4096
        },
        "minHeight": {
          "type": "integer",
          "minimum": 80,
          "maximum": 4096
        },
        "singleton": {
          "type": "boolean"
        },
        "resizable": {
          "type": "boolean"
        }
      }
    },
    "settings": {
      "description": "Where the module's settings live in the desktop's Settings: a section its host renders (`mount`, for a shipped module), a page on the application's own origin (`page`, for an origin module), or a form from a JSON Schema whose values the desktop keeps (`form`, for a document module, which has no server of its own). An application keeps its own values; the desktop is where the person finds them.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "mount"
          ],
          "properties": {
            "kind": {
              "const": "mount"
            },
            "mount": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "title": {
              "$ref": "#/$defs/text",
              "description": "The section's name in Settings; the module's title by default."
            },
            "keywords": {
              "type": "array",
              "maxItems": 24,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "description": "Words the person may search Settings by."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "page"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "title": {
              "$ref": "#/$defs/text",
              "description": "The section's name in Settings; the module's title by default."
            },
            "keywords": {
              "type": "array",
              "maxItems": 24,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "description": "Words the person may search Settings by."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "schema"
          ],
          "properties": {
            "kind": {
              "const": "form"
            },
            "schema": {
              "type": "object",
              "description": "A JSON Schema for the values. No secret: a member marked writeOnly or with format password is refused."
            },
            "title": {
              "$ref": "#/$defs/text",
              "description": "The section's name in Settings; the module's title by default."
            },
            "keywords": {
              "type": "array",
              "maxItems": 24,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "description": "Words the person may search Settings by."
            }
          }
        }
      ]
    },
    "proposals": {
      "description": "The kinds of proposal this module files in the desktop's inbox for the person to accept or reject. The module keeps its proposals and decides what accepting one does; the desktop only shows them and carries the person's decision back.",
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "title": {
            "$ref": "#/$defs/text",
            "description": "What a proposal of this kind is, for the person."
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "description": "Launch entries: each is its own dock icon that opens the module at one of its screens.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "icon": {
            "$ref": "#/$defs/icon"
          },
          "screen": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "folder": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,64}$"
          }
        }
      }
    },
    "dock": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the module's icons go in a dock the person has not arranged yet.",
      "properties": {
        "folder": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "folders": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,64}$"
              },
              "title": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract"
      ],
      "description": "The contract the module serves as a file location for the desktop's Files.",
      "properties": {
        "contract": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "assistant": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "required": [
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "es": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ja": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ko": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "nl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ru": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "zh-TW": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "glyph"
      ],
      "properties": {
        "glyph": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "description": "A glyph name from the shell's icon set."
        },
        "hue": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "description": "The tile's hue on the theme's colour wheel."
        }
      }
    }
  }
}
