{
  "name": "@tangleai/os",
  "version": "0.74.0",
  "description": "A browser operating system for Tangle suites: modules as JSON manifests and contracts, one desktop, one assistant.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./shell": "./src/shell.ts",
    "./module": "./src/module.ts",
    "./module-host": "./src/module-host.ts",
    "./settings": "./src/settings.ts",
    "./files": "./src/files-app.ts",
    "./web": "./src/web-app.ts",
    "./jobs": "./src/jobs.ts",
    "./jobs-app": "./src/jobs-app.ts",
    "./state-server": "./src/state-server.ts",
    "./testing": "./src/testing.ts",
    "./authoring": "./src/authoring.ts",
    "./messages": "./src/messages.ts",
    "./messages/ar": "./src/messages/ar.ts",
    "./messages/de": "./src/messages/de.ts",
    "./messages/es": "./src/messages/es.ts",
    "./messages/fr": "./src/messages/fr.ts",
    "./messages/ja": "./src/messages/ja.ts",
    "./messages/ko": "./src/messages/ko.ts",
    "./messages/nl": "./src/messages/nl.ts",
    "./messages/pt": "./src/messages/pt.ts",
    "./messages/ru": "./src/messages/ru.ts",
    "./messages/tr": "./src/messages/tr.ts",
    "./messages/zh-tw": "./src/messages/zh-tw.ts",
    "./schemas/module": "./schemas/module.schema.json",
    "./styles/os.css": "./styles/os.css",
    "./styles/module.css": "./styles/module.css"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": [
    "**/*.css",
    "./src/module-host.ts"
  ],
  "dependencies": {
    "@jarenjs/core": "0.226.0",
    "@jarenjs/json": "0.226.0",
    "@jarenjs/validate": "0.226.0",
    "@jarenjs/contract": "0.226.0",
    "@jarenjs/app": "0.226.0",
    "@jarenjs/forms": "0.226.0"
  },
  "private": false,
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "schemas/**/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "styles/**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "components/os"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
