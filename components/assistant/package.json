{
  "name": "@tangleai/assistant",
  "version": "0.45.2",
  "description": "Reusable assistant state, streaming lifecycle and optional Jaren visual component.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./component": "./src/component.ts",
    "./view": "./src/view.ts",
    "./messages": "./src/messages.ts",
    "./messages/ar": "./src/messages/ar.ts",
    "./messages/de": "./src/messages/de.ts",
    "./messages/es": "./src/messages/es.ts",
    "./messages/fr": "./src/messages/fr.ts",
    "./messages/nl": "./src/messages/nl.ts",
    "./messages/pt": "./src/messages/pt.ts",
    "./styles/assistant.css": "./styles/assistant.css"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@tangleai/models": "0.45.2",
    "@tangleai/context": "0.45.2",
    "@tangleai/agents": "0.45.2",
    "@jarenjs/core": "0.184.2",
    "@jarenjs/json": "0.184.2",
    "@jarenjs/app": "0.184.2",
    "@jarenjs/md": "0.184.2",
    "@jarenjs/mermaid": "0.184.2"
  },
  "private": false,
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "styles/**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "components/assistant"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
