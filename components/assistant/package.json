{
  "name": "@tangleai/assistant",
  "version": "0.29.1",
  "description": "Reusable assistant state, streaming lifecycle and optional Jaren visual component.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./component": "./src/component.ts",
    "./styles/assistant.css": "./styles/assistant.css"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@tangleai/models": "^0.29.1",
    "@tangleai/context": "^0.29.1",
    "@tangleai/agents": "^0.29.1",
    "@jarenjs/json": "0.90.6",
    "@jarenjs/app": "0.90.6",
    "@jarenjs/md": "0.90.6",
    "@jarenjs/mermaid": "0.90.6"
  },
  "private": false,
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "styles/**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jklarenbeek/tangleai.git",
    "directory": "components/assistant"
  },
  "scripts": {
    "prepack": "node ../../scripts/release/refuse-source-publish.ts",
    "prepublishOnly": "node ../../scripts/release/refuse-source-publish.ts"
  }
}
