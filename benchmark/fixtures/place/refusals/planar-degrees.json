{
  "$jslt": "0.1",
  "rules": [
    {
      "match": "$",
      "body": {
        "$for": {
          "c": "$.places[*]"
        },
        "$return": {
          "$hypot": [
            {
              "$sub": [
                "$c.at[0]",
                "$.here[0]"
              ]
            },
            {
              "$sub": [
                "$c.at[1]",
                "$.here[1]"
              ]
            }
          ]
        }
      }
    }
  ]
}
