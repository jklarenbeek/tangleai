{
  "$jslt": "0.1",
  "rules": [
    {
      "match": "$",
      "body": {
        "$for": {
          "c": "$.places[*]"
        },
        "$where": {
          "$and": [
            {
              "$gt": [
                "$c.lat",
                35
              ]
            },
            {
              "$lt": [
                "$c.lon",
                140
              ]
            }
          ]
        },
        "$return": "$c"
      }
    }
  ]
}
