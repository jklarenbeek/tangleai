{
  "$app": "0.1",
  "state": { "weight": 0, "height": 0 },
  "view": {
    "$jslt": "0.1",
    "rules": [
      {
        "match": "$",
        "body": ["div", { "class": "bmi" },
          ["h2", {}, "Body mass index"],
          ["label", {}, "Weight (kg) ", ["input", { "type": "number", "min": "0", "step": "any", "value": "$.weight", "on": { "input": "setWeight" } }]],
          ["label", {}, "Height (cm) ", ["input", { "type": "number", "min": "0", "step": "any", "value": "$.height", "on": { "input": "setHeight" } }]],
          ["p", { "class": "bmi-result" }, { "$if": [{ "$and": [{ "$gt": ["$.height", 0] }, { "$gt": ["$.weight", 0] }] },
            { "$concat": ["Your BMI is ", { "$string": { "$round": [{ "$div": ["$.weight", { "$mul": [{ "$div": ["$.height", 100] }, { "$div": ["$.height", 100] }] }] }, 1] } }] },
            "Enter your weight and height."] }]]
      }
    ]
  },
  "actions": {
    "setWeight": { "patch": [{ "op": "replace", "path": "/weight", "value": { "$if": [{ "$eq": ["$event.value", ""] }, 0, { "$number": "$event.value" }] } }] },
    "setHeight": { "patch": [{ "op": "replace", "path": "/height", "value": { "$if": [{ "$eq": ["$event.value", ""] }, 0, { "$number": "$event.value" }] } }] }
  }
}
