  "questions": [
    { "key": "q-relay-port", "kind": "answerable", "text": "What TCP port does the Harbor Relay listen on by default?", "reference": "The Harbor Relay listens on TCP port 7431 by default.", "claims": ["c-relay-port"] },
    { "key": "q-frame-size", "kind": "answerable", "text": "How large may a relay frame be, and what happens to an oversized frame?", "reference": "A frame carries at most 512 KiB of payload.; An oversized frame is rejected, never truncated.", "claims": ["c-frame-size", "c-frame-reject"] },
    { "key": "q-retry-backoff", "kind": "answerable", "text": "How does the Harbor Relay back off between delivery retries?", "reference": "Retries start at a 250 ms backoff.; The backoff doubles up to 8 seconds between attempts.", "claims": ["c-retry-base", "c-retry-cap"] },
    { "key": "q-queue-engine", "kind": "answerable", "text": "Which queue engine does the Harbor Relay use today?", "reference": "Since release 0.9 the relay queues frames through the rowan engine.", "claims": ["c-queue-engine"] },
    { "key": "q-handshake", "kind": "answerable", "text": "What are the stages of the Beacon handshake, in order?", "reference": "The first stage is hello.; The second stage is verify.; The third stage is adopt.", "claims": ["c-hs-hello", "c-hs-verify", "c-hs-adopt"] },
    { "key": "q-checksum", "kind": "answerable", "text": "Which checksum does a Beacon datagram carry, and over what?", "reference": "Every datagram carries a CRC32C checksum.; The checksum covers both the header and the payload.", "claims": ["c-checksum", "c-checksum-scope"] },
    { "key": "q-heartbeat", "kind": "answerable", "text": "How often does a connected Beacon peer emit a heartbeat?", "reference": "A peer emits a heartbeat every 20 seconds.", "claims": ["c-heartbeat"] },
    { "key": "q-compaction", "kind": "answerable", "text": "When does the Anchor ledger compact?", "reference": "The ledger compacts at 4096 entries.; A compaction pass also runs at every startup.", "claims": ["c-compaction", "c-compaction-startup"] },
    { "key": "q-snapshot-restore", "kind": "answerable", "text": "Which format does an Anchor ledger snapshot use, and which command restores one?", "reference": "Snapshots are written in the alder/2 format.; Snapshots are restored with the quay restore command.", "claims": ["c-snapshot-format", "c-restore-tool"] },
    { "key": "q-mooring-profile", "kind": "answerable", "text": "Which profile does a new mooring use, and what happens when it is missing?", "reference": "New moorings use the granite profile by default.; The tool falls back to the shale profile when granite is missing.", "claims": ["c-mooring-profile", "c-mooring-fallback"] },
    { "key": "q-mooring-rotate", "kind": "answerable", "text": "How often are mooring credentials rotated?", "reference": "Mooring credentials are rotated every 90 days.", "claims": ["c-mooring-rotate"] },
    { "key": "q-relay-tls", "kind": "answerable", "text": "Which TLS versions does the relay accept, and how are its certificates rotated?", "reference": "The relay accepts TLS 1.3 only.; Certificates are rotated with the quay tool's rotate-cert command.", "claims": ["c-relay-tls", "c-cert-rotate"] },
    { "key": "q-beacon-transport", "kind": "answerable", "text": "Over which transport and port does Beacon traffic travel?", "reference": "Beacon traffic travels over UDP on port 7432.", "claims": ["c-beacon-transport"] },
    { "key": "q-ledger-encoding", "kind": "answerable", "text": "How are Anchor ledger records encoded and written?", "reference": "Ledger records are encoded as CBOR.; The ledger file is strictly append-only.", "claims": ["c-ledger-encoding", "c-ledger-append"] },
