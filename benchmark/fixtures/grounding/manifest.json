  "elements": [
    { "key": "e-rg-port", "version": "relay-guide@1", "quote": "The Harbor Relay listens on TCP port 7431 by default; operators may move it, but every quay profile ships with 7431 preconfigured." },
    { "key": "e-rg-frame", "version": "relay-guide@1", "quote": "A relay frame may carry at most 512 KiB of payload. An oversized frame is rejected with code FRAME_TOO_LARGE and is never truncated." },
    { "key": "e-rg-retry", "version": "relay-guide@1", "quote": "Delivery retries start at a 250 ms backoff and double on every failed attempt, up to a hard cap of 8 seconds between attempts." },
    { "key": "e-rg-tls", "version": "relay-guide@1", "quote": "The relay terminates TLS 1.3 only; earlier protocol versions are refused during the hello. Certificates are rotated with the quay tool's rotate-cert command." },
    { "key": "e-h1-cedar", "version": "relay-history@1", "quote": "The Harbor Relay queues outbound frames through the cedar engine, a single-writer log borrowed from the original prototype." },
    { "key": "e-h2-rowan", "version": "relay-history@2", "quote": "Since release 0.9 the Harbor Relay queues outbound frames through the rowan engine; rowan replaced the earlier cedar engine, which is no longer built." },
    { "key": "e-bs-handshake", "version": "beacon-spec@1", "quote": "A Beacon handshake proceeds in three stages: hello, verify, adopt. No stage may be skipped, and a peer that fails verify must restart from hello." },
    { "key": "e-bs-checksum", "version": "beacon-spec@1", "quote": "Every Beacon datagram carries a CRC32C checksum computed over both the header and the payload." },
    { "key": "e-bs-heartbeat", "version": "beacon-spec@1", "quote": "A connected Beacon peer emits a heartbeat every 20 seconds; three missed heartbeats retire the peer." },
    { "key": "e-bs-transport", "version": "beacon-spec@1", "quote": "Beacon traffic travels over UDP on port 7432, one datagram per frame." },
    { "key": "e-ln-compaction", "version": "ledger-notes@1", "quote": "The Anchor ledger compacts once it holds 4096 entries, and it also runs one compaction pass at every startup." },
    { "key": "e-ln-snapshot", "version": "ledger-notes@1", "quote": "Ledger snapshots are written in the alder/2 format." },
    { "key": "e-ln-encoding", "version": "ledger-notes@1", "quote": "Ledger records are encoded as CBOR and the ledger file is strictly append-only." },
    { "key": "e-fc-attach", "version": "future-changelog@1", "quote": "Release 1.2 renames the Beacon handshake's adopt stage to attach; the wire bytes are unchanged." },
    { "key": "e-pg-legacy", "version": "port-glossary@1", "quote": "Before Harbor existed, the legacy relay listened on TCP port 7000 and framed payloads without any size limit." },
    { "key": "e-pg-terms", "version": "port-glossary@1", "quote": "In quay terminology a frame is any length-prefixed payload, a port is a numbered endpoint, and a relay is any process that forwards frames." },
    { "key": "e-pg-retry", "version": "port-glossary@1", "quote": "The legacy relay retried deliveries on a fixed one-second timer and never backed off." },
    { "key": "e-qf-restore", "version": "quay-faq@1", "quote": "Snapshots are restored with the quay restore command, which verifies the snapshot format before touching the ledger." },
    { "key": "e-mh-profile", "version": "mooring-howto@1", "quote": "New moorings use the granite profile by default; when the granite profile is missing the tool falls back to the shale profile." },
    { "key": "e-mh-rotate", "version": "mooring-howto@1", "quote": "Mooring credentials are rotated every 90 days." }
  ],
