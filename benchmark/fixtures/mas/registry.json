        "versionId": "2f3d6f5e03ab97cf9bd70569dfc690c5fa89f5618bd26aa1b2275bc2c4e41b81",
        "parentVersionId": null,
        "title": "Nested state body — work over pulled state",
        "description": "Pulls one parent member into local state, produces one pushed member, and can address nothing else.",
        "provenance": {
          "author": "tangle-conformance"
        },
        "input": {
          "schema": {
            "type": "object",
            "required": [
              "go"
            ],
            "properties": {
              "go": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "output": {
          "schema": {
            "type": "object",
            "required": [
              "done"
            ],
            "properties": {
              "done": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "entry": [
          {
            "port": "go",
            "to": {
              "node": "work",
              "port": "go"
            }
          }
        ],
        "exit": [
          {
            "port": "done",
            "from": {
              "node": "work",
              "port": "done"
            }
          }
        ],
        "state": {
          "schema": {
            "type": "object",
            "required": [
              "inherited",
              "produced"
            ],
            "properties": {
              "inherited": {
                "type": "number"
              },
              "produced": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "init": {
            "inherited": 0,
            "produced": 0
          }
        },
        "nodes": [
          {
            "id": "work",
            "kind": "task",
            "input": {
              "ports": {
                "go": {
                  "schema": {
                    "type": "boolean"
                  }
                }
              }
            },
            "output": {
              "ports": {
                "made": {
                  "schema": {
                    "type": "number"
                  }
                },
                "done": {
                  "schema": {
                    "type": "boolean"
                  }
                }
              }
            },
            "statePull": [
              {
                "member": "/inherited",
                "as": "inherited"
              }
            ],
            "statePush": [
              {
                "from": "made",
                "member": "/produced"
              }
            ],
            "limits": null,
            "handler": "scripted",
            "effect": "pure"
          }
        ],
