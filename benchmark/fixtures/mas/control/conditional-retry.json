        }
      }
    ],
    "exit": [
      {
        "port": "result",
        "from": {
          "node": "attempt",
          "port": "result"
        }
      }
    ],
    "state": {
      "schema": {
        "type": "object",
        "required": [],
        "properties": {},
        "additionalProperties": false
      },
      "init": {}
    },
    "nodes": [
      {
        "id": "attempt",
        "kind": "loop",
        "input": {
          "ports": {
            "start": {
              "schema": {
                "type": "object",
                "required": [
                  "n",
                  "goal"
                ],
                "properties": {
                  "n": {
                    "type": "number"
                  },
                  "goal": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "output": {
          "ports": {
            "result": {
              "schema": {
                "type": "object",
                "required": [
                  "ok",
                  "n",
                  "goal"
                ],
                "properties": {
                  "ok": {
                    "type": "boolean"
                  },
                  "n": {
                    "type": "number"
                  },
                  "goal": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "statePull": [],
        "statePush": [],
        "limits": null,
        "body": "retry-body",
        "init": [
          {
            "port": "start",
            "to": ""
          }
        ],
        "feedback": [
          {
            "from": "/n",
            "to": "/n"
          },
          {
            "from": "/goal",
            "to": "/goal"
          }
        ],
        "result": [
