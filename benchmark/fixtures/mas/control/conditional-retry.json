    "parentVersionId": null,
    "title": "Conditional retry",
    "description": "The loop contract as declared recovery: a typed body failure feeds the next attempt; the cap can never be exceeded.",
    "provenance": {
      "author": "tangle-conformance"
    },
    "input": {
      "schema": {
        "type": "object",
        "required": [
          "start"
        ],
        "properties": {
          "start": {
            "type": "object",
            "required": [
              "n",
              "goal"
            ],
            "properties": {
              "n": {
                "type": "number"
              },
              "goal": {
