              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "output": {
      "schema": {
        "type": "object",
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "object",
            "required": [
              "ok",
              "n",
              "goal"
            ],
