        "ok": true,
        "n": 3,
        "goal": 2
      }
    },
    "failure": null,
    "events": [
      "attempt/1/try:completed",
      "attempt/2/try:completed",
      "attempt:completed"
    ],
    "aggregations": [],
    "concurrency": {
