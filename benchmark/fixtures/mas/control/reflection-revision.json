  "script": {
    "input": {
      "seed": {
        "text": "draft zero",
        "quality": 0
      }
    },
    "handlers": {
      "polish/reflect": {
        "query": {
          "critique": {
            "text": "$.text",
            "quality": "$.quality"
          }
        }
      },
      "polish/revise": {
        "query": {
          "text": {
            "$concat": [
              "$.critique.text",
              "+"
            ]
          },
          "quality": {
            "$add": [
              "$.critique.quality",
              1
            ]
          }
        }
      }
    },
    "agents": {},
    "gate": null,
    "stopAfter": null,
    "respond": null,
    "failAt": null
  },
