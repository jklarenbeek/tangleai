        "replayed": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "uncertain": {
          "type": "integer",
          "minimum": 0
        },
        "versions": {
          "type": "integer",
          "minimum": 0
        },
        "promotions": {
          "type": "integer",
          "minimum": 0
        },
        "rollbacks": {
          "type": "integer",
          "minimum": 0
        },
        "retainedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "projectionApplied": {
          "type": "integer",
          "minimum": 0
        },
        "projectionMissing": {
          "type": "integer",
          "minimum": 0
        },
        "projectionChanged": {
          "type": "integer",
          "minimum": 0
        },
        "proposed": {
          "type": "integer",
          "minimum": 0
        },
        "evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "eligible": {
          "type": "integer",
          "minimum": 0
        },
        "approved": {
          "type": "integer",
          "minimum": 0
        },
        "maxVersions": {
          "type": "integer",
          "minimum": 0
        },
        "reflectionBytes": {
          "type": "integer",
          "minimum": 0
        },
        "projectionReplayed": {
          "type": "integer",
          "minimum": 0
        },
        "projectionFailed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "planned",
        "available",
        "pending",
        "scored",
        "unscored",
        "success",
        "partial",
        "failure",
        "physicalRequests",
        "scriptedCalls",
        "writes",
        "replayed",
        "refused",
        "failed",
        "uncertain",
        "versions",
        "promotions",
        "rollbacks",
        "retainedBytes",
        "projectionApplied",
        "projectionMissing",
        "projectionChanged",
        "proposed",
        "evaluated",
        "eligible",
        "approved",
        "maxVersions",
        "reflectionBytes",
        "projectionReplayed",
        "projectionFailed"
      ],
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "measured",
            "not-implemented",
            "expected-unsafe"
          ]
        },
        "evidence": {
          "enum": [
            "oracle",
            "legacy",
            "scripted",
            "unavailable",
            "unsafe-control"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measurement"
          }
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "utility": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "conditionalUtility": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "usageKnown": {
          "type": "boolean"
        },
        "probes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/probe"
          }
        }
      },
      "required": [
        "id",
        "status",
        "evidence",
        "reason",
        "cases",
        "counts",
        "utility",
        "conditionalUtility",
        "cost",
        "usageKnown",
        "probes"
      ],
      "additionalProperties": false,
      "$query": {
        "$and": [
          {
            "$eq": [
              "$.counts.planned",
              {
                "$add": [
                  "$.counts.available",
                  "$.counts.pending"
                ]
              }
            ]
          },
          {
            "$eq": [
              "$.counts.available",
              {
                "$add": [
                  "$.counts.scored",
                  "$.counts.unscored"
                ]
              }
            ]
          },
          {
            "$eq": [
              "$.counts.scored",
              {
                "$add": [
                  {
                    "$add": [
                      "$.counts.success",
                      "$.counts.partial"
                    ]
                  },
                  "$.counts.failure"
                ]
              }
            ]
          },
          {
            "$eq": [
              {
                "$count": "$.cases[*].id"
              },
              {
                "$count": {
                  "$distinct": "$.cases[*].id"
                }
              }
            ]
          }
        ]
      }
    },
    "trace": {
      "type": "object",
      "properties": {
        "rowId": {
          "type": "string"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        "memories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        "writes": {
          "type": "integer",
          "minimum": 0
        },
        "resolverReads": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "rowId",
        "records",
        "memories",
        "writes",
        "resolverReads"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "binding": {
          "enum": [
            "local",
            "http",
            "direct"
          ]
        },
        "store": {
          "enum": [
            "memory",
            "sqlite"
          ]
        },
        "runtime": {
          "enum": [
            "node",
            "bun"
          ]
        },
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "contractRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace": {
          "$ref": "#/$defs/trace"
        }
      },
      "required": [
        "binding",
        "store",
        "runtime",
        "requests",
        "contractRevision",
        "trace"
      ],
      "additionalProperties": false
    }
  },
  "$query": {
    "$eq": [
      {
        "$count": "$.rows[*].id"
      },
      {
        "$count": {
          "$distinct": "$.rows[*].id"
        }
      }
    ]
  }
}
