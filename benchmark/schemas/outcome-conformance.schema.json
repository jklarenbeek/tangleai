        },
        "promotion": {
          "type": "boolean"
        },
        "contract": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "oracle",
        "storage",
        "resolution",
        "promotion",
        "contract",
        "complete"
