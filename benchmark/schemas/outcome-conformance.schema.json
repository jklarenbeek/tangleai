      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "round": {
          "type": "integer",
          "minimum": 0
        },
        "available": {
          "type": "boolean"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "success",
                "partial",
                "failure"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "utility": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "scored",
            "pending",
            "failed"
          ]
        },
        "versionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "domain",
        "round",
        "available",
        "outcome",
        "utility",
        "status",
        "versionId"
      ],
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/json"
        },
        "actual": {
          "$ref": "#/$defs/json"
        },
        "holds": {
          "type": "boolean"
        },
        "capability": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "expected",
        "actual",
        "holds",
        "capability"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "planned": {
          "type": "integer",
          "minimum": 0
        },
        "available": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "scored": {
          "type": "integer",
          "minimum": 0
        },
        "unscored": {
          "type": "integer",
          "minimum": 0
        },
        "success": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "minimum": 0
        },
        "failure": {
          "type": "integer",
