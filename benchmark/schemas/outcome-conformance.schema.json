            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "digest"
            ],
            "additionalProperties": false
          }
        },
        "quality": {
          "type": "object",
          "properties": {
            "rounds": {
              "const": 4
            },
            "planned": {
              "const": 32
            },
            "available": {
              "const": 24
            },
            "pending": {
              "const": 8
            }
          },
          "required": [
            "rounds",
            "planned",
            "available",
            "pending"
          ],
          "additionalProperties": false
        },
        "heldOut": {
          "const": 24
        },
        "policy": {
          "type": "object",
          "properties": {
            "maxVersions": {
              "type": "integer",
              "minimum": 0
            },
            "maxPayloadBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maxOperations": {
              "type": "integer",
              "minimum": 0
            },
            "maxChangedLeaves": {
              "type": "integer",
              "minimum": 0
            },
            "maxReflectionBytes": {
              "type": "integer",
              "minimum": 0
            },
            "physicalRequests": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "maxVersions",
            "maxPayloadBytes",
            "maxOperations",
            "maxChangedLeaves",
            "maxReflectionBytes",
            "physicalRequests"
          ],
          "additionalProperties": false
        },
        "configuration": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "scripted"
            },
            "version": {
              "const": 1
            }
          },
          "required": [
            "kind",
            "version"
          ],
          "additionalProperties": false
        },
        "registrationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "namespace",
        "subject",
        "adapters",
        "files",
        "quality",
        "heldOut",
        "policy",
        "configuration",
        "registrationId"
      ],
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "properties": {
