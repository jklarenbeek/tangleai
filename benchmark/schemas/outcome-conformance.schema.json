                "type": "number"
              },
              "actual": {
                "type": "number"
              },
              "outcome": {
                "enum": [
                  "success",
                  "partial",
                  "failure"
                ]
              }
            },
            "required": [
              "predicted",
              "actual",
              "outcome"
            ],
            "additionalProperties": false
          }
        },
        "candidates": {
          "type": "object",
          "properties": {
            "direction-delta": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/json"
              }
            },
            "exact-match": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/json"
              }
            }
          },
          "required": [
            "direction-delta",
            "exact-match"
          ],
          "additionalProperties": false
        },
        "static": {
          "type": "object",
          "properties": {
            "direction-delta": {
              "$ref": "#/$defs/json"
            },
            "exact-match": {
              "$ref": "#/$defs/json"
            }
          },
          "required": [
            "direction-delta",
            "exact-match"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "scenarios",
        "scores",
        "candidates",
        "static"
      ],
      "additionalProperties": false
