        "input": {
          "$ref": "#/$defs/json"
        },
        "outcome": {
          "$ref": "#/$defs/json"
        },
        "expectedStatic": {
          "enum": [
            "success",
            "partial",
            "failure"
          ]
        }
      },
      "required": [
        "id",
        "domain",
        "slot",
        "input",
        "outcome",
        "expectedStatic"
      ],
      "additionalProperties": false
