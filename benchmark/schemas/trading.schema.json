{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tangleai.dev/schemas/trading-report",
  "title": "TradingReport",
  "type": "object",
  "properties": {
    "instrument": {
      "const": "trading"
    },
    "version": {
      "const": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "suite": {
      "type": "object",
      "properties": {
        "tangle": {
          "type": "string",
          "minLength": 1
        },
        "jaren": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tangle",
        "jaren"
      ],
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "properties": {
        "id": {
          "const": "trading-synthetic-v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "licence": {
          "const": "MIT"
        }
      },
      "required": [
        "id",
        "sha256",
        "licence"
      ],
      "additionalProperties": false
    },
    "registration": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/strategy"
      },
      "minItems": 10,
      "maxItems": 10
    },
    "conventions": {
      "$ref": "#/$defs/metricConventions"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      },
      "minItems": 10,
      "maxItems": 10
    },
    "poison": {
      "$ref": "#/$defs/poisonAudit"
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "identity": {
      "type": "object",
      "properties": {
        "identities": {
          "type": "array",
          "items": {},
          "maxItems": 0
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rowId": {
                "type": "string",
                "minLength": 1
              },
              "identityStatus": {
                "const": "not-run"
              }
            },
            "required": [
              "rowId",
              "identityStatus"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "identities",
        "rows"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reportId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "instrument",
    "version",
    "source",
    "suite",
    "fixture",
    "registration",
    "conventions",
    "rows",
    "poison",
    "counts",
    "capabilities",
    "identity",
    "limitations",
    "reportId"
  ],
  "additionalProperties": false,
  "$query": {
    "$and": [
      {
        "$eq": [
          {
            "$count": {
              "$distinct": "$.rows[*].id"
            }
          },
          10
        ]
      },
      {
        "$eq": [
          [
            "$.rows[*].id"
          ],
          [
            "$.registration[*].id"
          ]
        ]
      },
      {
        "$every": {
          "r": "$.rows[*]"
        },
        "$satisfies": {
          "$or": [
            {
              "$ne": [
                "$r.status",
                "excluded"
              ]
            },
            {
              "$and": [
                {
                  "$ne": [
                    "$r.reason",
                    null
                  ]
                },
                {
                  "$eq": [
                    "$r.eligibility.eligible",
                    false
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "$eq": [
          "$.counts.registered",
          {
            "$count": "$.rows[*]"
          }
        ]
      },
      {
        "$eq": [
          "$.counts.measured",
          {
            "$count": "$.rows[?(@.status=='measured')]"
          }
        ]
      },
      {
        "$eq": [
          "$.counts.excluded",
          {
            "$count": "$.rows[?(@.status=='excluded')]"
          }
        ]
      },
      {
        "$eq": [
          "$.counts.implementationMissing",
          {
            "$count": "$.rows[?(@.status=='implementation-missing')]"
          }
        ]
      },
      {
        "$eq": [
          "$.counts.notRun",
          {
            "$count": "$.rows[?(@.status=='not-run')]"
          }
        ]
      },
      {
        "$eq": [
          "$.counts.transactions",
          {
            "$sum": "$.rows[*].transactions"
          }
        ]
      },
      {
        "$eq": [
          "$.counts.rejectedOrders",
          {
            "$sum": "$.rows[*].rejectedOrders"
          }
        ]
      },
      {
        "$eq": [
          "$.counts.refusedObservations",
          {
            "$sum": "$.rows[*].refusedObservations"
          }
        ]
      }
    ]
  },
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "clean": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "head",
        "clean",
        "sha256",
        "files"
      ],
      "additionalProperties": false
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "asset": {
      "enum": [
        "SYN-A",
        "SYN-B"
      ]
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "openAt": {
          "type": "string",
          "format": "date-time"
        },
        "closeAt": {
          "type": "string",
          "format": "date-time"
        },
        "prev": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "next": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "date",
        "openAt",
        "closeAt",
        "prev",
        "next"
      ],
      "additionalProperties": false
    },
    "bar": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "eventAt": {
          "type": "string",
          "format": "date-time"
        },
        "availableAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "const": "bar"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "open": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "high": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "low": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "close": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "adjustedClose": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "volume": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "asset",
        "eventAt",
        "availableAt",
        "sourceId",
        "revisionId",
        "contentHash",
        "kind",
        "sessionId",
        "open",
        "high",
        "low",
        "close",
        "adjustedClose",
        "volume"
      ],
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "eventAt": {
          "type": "string",
          "format": "date-time"
        },
        "availableAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "fundamental",
            "news",
            "social",
            "insider",
            "profile"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "providerSentiment": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "modelInterpretation": {
          "const": null
        }
      },
      "required": [
        "id",
        "asset",
        "eventAt",
        "availableAt",
        "sourceId",
        "revisionId",
        "contentHash",
        "kind",
        "text",
        "providerSentiment",
        "modelInterpretation"
      ],
      "additionalProperties": false
    },
    "corporateAction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "eventAt": {
          "type": "string",
          "format": "date-time"
        },
        "availableAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "const": "corporate-action"
        },
        "action": {
          "enum": [
            "split",
            "dividend"
          ]
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "ratio": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cashPerShare": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "asset",
        "eventAt",
        "availableAt",
        "sourceId",
        "revisionId",
        "contentHash",
        "kind",
        "action",
        "sessionId",
        "ratio",
        "cashPerShare"
      ],
      "additionalProperties": false
    },
    "observation": {
      "oneOf": [
        {
          "$ref": "#/$defs/bar"
        },
        {
          "$ref": "#/$defs/release"
        },
        {
          "$ref": "#/$defs/corporateAction"
        }
      ]
    },
    "strategy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "control",
            "baseline",
            "agent"
          ]
        },
        "parityTier": {
          "enum": [
            "control",
            "mechanism",
            "experimental"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "parityTier",
        "description"
      ],
      "additionalProperties": false
    },
    "metricConventions": {
      "type": "object",
      "properties": {
        "periodicity": {
          "const": "session-close-to-close"
        },
        "sessionsPerYear": {
          "type": "integer",
          "minimum": 1
        },
        "riskFree": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "zero-series"
            },
            "perSession": {
              "const": 0
            }
          },
          "required": [
            "kind",
            "perSession"
          ],
          "additionalProperties": false
        },
        "annualization": {
          "type": "number"
        },
        "annualizationText": {
          "const": "sqrt(sessionsPerYear)"
        },
        "formulas": {
          "type": "object",
          "properties": {
            "cr": {
              "type": "string",
              "minLength": 1
            },
            "ar": {
              "type": "string",
              "minLength": 1
            },
            "sharpe": {
              "type": "string",
              "minLength": 1
            },
            "mdd": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "cr",
            "ar",
            "sharpe",
            "mdd"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "periodicity",
        "sessionsPerYear",
        "riskFree",
        "annualization",
        "annualizationText",
        "formulas"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "cr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "ar": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "sharpe": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "mdd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessions": {
          "type": "integer",
          "minimum": 0
        },
        "returns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "cr",
        "ar",
        "sharpe",
        "mdd",
        "sessions",
        "returns"
      ],
      "additionalProperties": false
    },
    "undefinedMetric": {
      "type": "object",
      "properties": {
        "metric": {
          "enum": [
            "cr",
            "ar",
            "sharpe",
            "mdd"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "metric",
        "reason"
      ],
      "additionalProperties": false
    },
    "costs": {
      "type": "object",
      "properties": {
        "commission": {
          "type": "number",
          "minimum": 0
        },
        "slippage": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "commission",
        "slippage",
        "total"
      ],
      "additionalProperties": false
    },
    "goldenFill": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "decisionSessionId": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "enum": [
            "buy",
            "sell"
          ]
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "price": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "commission": {
          "type": "number",
          "minimum": 0
        },
        "slippage": {
          "type": "number",
          "minimum": 0
        },
        "notional": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "id",
        "asset",
        "decisionSessionId",
        "sessionId",
        "side",
        "quantity",
        "price",
        "commission",
        "slippage",
        "notional"
      ],
      "additionalProperties": false
    },
    "goldenLedger": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fillId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "debit": {
          "type": "string",
          "minLength": 1
        },
        "credit": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "fillId",
        "sessionId",
        "asset",
        "debit",
        "credit",
        "amount"
      ],
      "additionalProperties": false
    },
    "goldenPosition": {
      "type": "object",
      "properties": {
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "quantity": {
          "type": "number",
          "minimum": 0
        },
        "costBasis": {
          "type": "number",
          "minimum": 0
        },
        "mark": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "realizedPnl": {
          "type": "number"
        },
        "unrealizedPnl": {
          "type": "number"
        },
        "cashFlow": {
          "type": "number"
        }
      },
      "required": [
        "asset",
        "quantity",
        "costBasis",
        "mark",
        "realizedPnl",
        "unrealizedPnl",
        "cashFlow"
      ],
      "additionalProperties": false
    },
    "goldenPoint": {
      "type": "object",
      "properties": {
        "sessionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cash": {
          "type": "number"
        },
        "equity": {
          "type": "number"
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goldenPosition"
          }
        }
      },
      "required": [
        "sessionId",
        "cash",
        "equity",
        "positions"
      ],
      "additionalProperties": false
    },
    "goldenAsset": {
      "type": "object",
      "properties": {
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "equity": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "undefined": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/undefinedMetric"
          }
        },
        "fills": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "asset",
        "equity",
        "metrics",
        "undefined",
        "fills"
      ],
      "additionalProperties": false
    },
    "golden": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "oracle",
            "do-nothing",
            "leaky"
          ]
        },
        "privileged": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "equity": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goldenPoint"
          },
          "minItems": 2
        },
        "fills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goldenFill"
          }
        },
        "ledger": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goldenLedger"
          }
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "undefined": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/undefinedMetric"
          }
        },
        "costs": {
          "$ref": "#/$defs/costs"
        },
        "perAsset": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goldenAsset"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "id",
        "privileged",
        "reason",
        "equity",
        "points",
        "fills",
        "ledger",
        "metrics",
        "undefined",
        "costs",
        "perAsset"
      ],
      "additionalProperties": false
    },
    "fixtureManifest": {
      "type": "object",
      "properties": {
        "id": {
          "const": "trading-synthetic-v1"
        },
        "licence": {
          "const": "MIT"
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "generatorVersion": {
          "const": 1
        },
        "generatorSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "seed": {
          "const": 7331
        },
        "assets": {
          "const": [
            "SYN-A",
            "SYN-B"
          ]
        },
        "calendar": {
          "const": "SYNX"
        },
        "currency": {
          "const": "USD"
        },
        "initialCapital": {
          "const": 100000
