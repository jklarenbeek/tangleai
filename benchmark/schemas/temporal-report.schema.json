            "answer",
            "judge",
            "embedding"
          ],
          "additionalProperties": false
        },
        "worstCaseUsd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "eligibleForApproval": {
          "type": "boolean"
