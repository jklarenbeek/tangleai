      },
      "required": [
        "sha256",
        "questions",
        "profileCases",
        "sourceOccurrences",
        "physicalRequestsMaximum",
        "inputByteTokenCeiling",
        "outputTokenCeiling",
        "embeddingLogicalItems",
        "embeddingPhysicalBatches",
        "blockedSources",
        "roleRequests",
        "worstCaseUsd",
        "eligibleForApproval"
      ],
      "additionalProperties": false
    },
    "experiment": {
      "type": "object",
      "properties": {
        "instrument": {
          "const": "temporal-experiment-v1"
        },
        "origin": {
          "const": "keyless"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "registrationHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "questionRows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keylessQuestion"
          }
        },
        "summaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          }
        },
        "plan": {
          "$ref": "#/$defs/planSummary"
        },
        "strict": {
          "type": "object",
          "properties": {
            "planned": {
              "type": "integer",
              "minimum": 0
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "unavailable": {
              "type": "integer",
              "minimum": 0
            },
            "notImplemented": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "planned",
            "passed",
            "failed",
            "unavailable",
            "notImplemented"
          ],
          "additionalProperties": false
        },
        "counts": {
          "type": "object",
          "properties": {
            "questions": {
              "type": "integer",
              "minimum": 0
            },
            "profileCases": {
              "type": "integer",
              "minimum": 0
            },
            "plannedRows": {
              "type": "integer",
              "minimum": 0
            },
            "measuredRows": {
              "type": "integer",
              "minimum": 0
            },
            "unmeasuredRows": {
              "type": "integer",
              "minimum": 0
            },
            "refusedRows": {
              "type": "integer",
              "minimum": 0
            },
            "fallbackRows": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "questions",
            "profileCases",
            "plannedRows",
            "measuredRows",
            "unmeasuredRows",
            "refusedRows",
            "fallbackRows"
          ],
          "additionalProperties": false
        },
        "physicalRequests": {
          "const": 0
        },
        "default": {
          "const": "off"
        },
        "liveQuality": {
          "const": "unmeasured"
        },
        "liveCost": {
          "const": "unmeasured"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "instrument",
        "origin",
        "context",
        "registrationHash",
        "questionRows",
