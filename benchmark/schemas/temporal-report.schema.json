          "minimum": 0
        },
        "physicalRequestsMaximum": {
          "type": "integer",
          "minimum": 0
        },
        "inputByteTokenCeiling": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokenCeiling": {
          "type": "integer",
          "minimum": 0
        },
        "embeddingLogicalItems": {
          "type": "integer",
          "minimum": 0
        },
        "embeddingPhysicalBatches": {
          "type": "integer",
          "minimum": 0
        },
        "blockedSources": {
          "type": "integer",
          "minimum": 0
        },
        "roleRequests": {
          "type": "object",
          "properties": {
            "extract": {
              "type": "integer",
              "minimum": 0
            },
            "resolve": {
              "type": "integer",
              "minimum": 0
            },
            "answer": {
              "type": "integer",
              "minimum": 0
            },
            "judge": {
              "type": "integer",
              "minimum": 0
            },
            "embedding": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "extract",
