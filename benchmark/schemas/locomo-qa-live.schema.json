{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tangleai.dev/schemas/locomo-qa-live",
  "title": "LoCoMo answer-path report, live tier — a dated run of a real model",
  "description": "What `benchmark/locomo-qa.ts --live` writes: the same sample as the keyless document, answered by a chat model over memories ranked through a real embedding wire, with the ceiling beside every F1, the cost beside both, and the category-5 judgments apart. Timing and a clock reading ARE in here — this document records one run and is never regenerated by a test; the tests validate it and render from it.",
  "type": "object",
  "required": ["benchmark", "instrument", "generated", "dataset", "config", "sample", "plan", "embedding", "spent", "errors", "configurations"],
  "additionalProperties": false,
  "properties": {
    "benchmark": { "const": "locomo" },
    "instrument": { "const": "locomo-qa-live" },
    "generated": {
      "type": "object",
      "required": ["at", "provider", "model", "judgeModel", "embedder", "keySource", "thinking"],
      "additionalProperties": false,
      "properties": {
        "at": { "$ref": "https://tangleai.dev/schemas/locomo-recall#/definitions/instant" },
        "provider": { "enum": ["ollama", "openrouter", "lmstudio", "custom"] },
        "model": { "type": "string", "minLength": 1 },
        "judgeModel": { "type": "string", "minLength": 1 },
        "embedder": {
          "type": "object",
          "required": ["model", "dims"],
          "additionalProperties": false,
          "properties": { "model": { "type": "string", "minLength": 1 }, "dims": { "type": "integer", "minimum": 0 } }
        },
        "keySource": {
          "description": "The NAME of the variable the key came from; the key itself may never appear in a report.",
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }]
        },
        "thinking": { "enum": ["off", "default"] }
      }
    },
    "dataset": { "$ref": "https://tangleai.dev/schemas/locomo-recall#/properties/dataset" },
    "config": {
      "description": "The keyless document's config, except that a run skipped before the wire answered has no settled width yet (`dims: 0`).",
      "type": "object",
      "required": ["embedder", "k", "ingest", "clock", "maxPairs"],
      "additionalProperties": false,
      "properties": {
        "embedder": {
          "type": "object",
          "required": ["model", "dims"],
          "additionalProperties": false,
          "properties": { "model": { "type": "string", "minLength": 1 }, "dims": { "type": "integer", "minimum": 0 } }
        },
        "k": { "type": "integer", "minimum": 1 },
        "ingest": { "const": "per-session" },
        "clock": { "type": "string", "minLength": 1 },
        "maxPairs": { "type": "integer", "minimum": 0 }
      }
    },
    "sample": { "$ref": "https://tangleai.dev/schemas/locomo-qa#/definitions/sample" },
    "plan": {
      "type": "object",
      "required": ["embedRequests", "chatCalls", "judgeCalls", "planned", "maxCalls", "skipped"],
      "additionalProperties": false,
      "properties": {
        "embedRequests": { "type": "integer", "minimum": 0 },
        "chatCalls": { "type": "integer", "minimum": 0 },
        "judgeCalls": { "type": "integer", "minimum": 0 },
        "planned": { "type": "integer", "minimum": 0 },
        "maxCalls": { "type": "integer", "minimum": 1 },
        "skipped": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] }
      }
    },
    "embedding": {
      "type": "object",
      "required": ["requests", "texts"],
      "additionalProperties": false,
      "properties": { "requests": { "type": "integer", "minimum": 0 }, "texts": { "type": "integer", "minimum": 0 } }
    },
    "spent": {
      "type": "object",
      "required": ["turns", "tokens", "ms"],
      "additionalProperties": false,
      "properties": {
        "turns": { "type": "integer", "minimum": 0 },
        "tokens": { "type": "integer", "minimum": 0 },
        "ms": { "type": "number", "minimum": 0 }
      }
    },
    "errors": {
      "type": "object",
      "required": ["count", "sample"],
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "sample": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "configurations": {
      "type": "array",
      "items": { "$ref": "#/definitions/configuration" }
    }
  },
  "definitions": {
    "cost": {
      "type": "object",
      "required": ["turns", "tokens", "promptTokens", "completionTokens", "ms"],
      "additionalProperties": false,
      "properties": {
        "turns": { "type": "integer", "minimum": 0 },
        "tokens": { "type": "integer", "minimum": 0 },
        "promptTokens": { "type": "integer", "minimum": 0 },
        "completionTokens": { "type": "integer", "minimum": 0 },
        "ms": { "type": "number", "minimum": 0 }
      }
    },
    "latency": {
      "type": "object",
      "required": ["count", "medianMs", "p95Ms"],
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "medianMs": { "oneOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }] },
        "p95Ms": { "oneOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }] }
      }
    },
    "unanswered": {
      "type": "object",
      "required": ["wire", "budget"],
      "additionalProperties": false,
      "properties": { "wire": { "type": "integer", "minimum": 0 }, "budget": { "type": "integer", "minimum": 0 } }
    },
    "configuration": {
      "type": "object",
      "required": ["key", "label", "thresholds", "ingest", "retrieval", "questions", "f1", "ceiling", "citedRecall", "citations", "cost", "latency", "adversarial"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "thresholds": { "$ref": "https://tangleai.dev/schemas/locomo-recall#/definitions/thresholds" },
        "ingest": { "$ref": "https://tangleai.dev/schemas/locomo-recall#/definitions/ingest" },
        "retrieval": { "$ref": "https://tangleai.dev/schemas/locomo-qa#/definitions/retrieval" },
        "questions": {
          "type": "object",
          "required": ["planned", "answered", "unanswered", "invalid"],
          "additionalProperties": false,
          "properties": {
            "planned": { "type": "integer", "minimum": 0 },
            "answered": { "type": "integer", "minimum": 0 },
            "unanswered": { "$ref": "#/definitions/unanswered" },
            "invalid": { "type": "integer", "minimum": 0 }
          }
        },
        "f1": { "$ref": "https://tangleai.dev/schemas/locomo-qa#/definitions/byCategory" },
        "ceiling": { "$ref": "https://tangleai.dev/schemas/locomo-qa#/definitions/byCategory" },
        "citedRecall": { "$ref": "https://tangleai.dev/schemas/locomo-qa#/definitions/byCategory" },
        "citations": {
          "type": "object",
          "required": ["cited", "uncited", "total", "unresolved", "answersWithUnresolved"],
          "additionalProperties": false,
          "properties": {
            "cited": { "type": "integer", "minimum": 0 },
            "uncited": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 },
            "unresolved": { "type": "integer", "minimum": 0 },
            "answersWithUnresolved": { "type": "integer", "minimum": 0 }
          }
        },
        "cost": { "$ref": "#/definitions/cost" },
        "latency": { "$ref": "#/definitions/latency" },
        "adversarial": {
          "type": "object",
          "required": ["planned", "judged", "correct", "accuracy", "keyword", "unanswered", "judgeFailed", "cost"],
          "additionalProperties": false,
          "properties": {
            "planned": { "type": "integer", "minimum": 0 },
            "judged": { "type": "integer", "minimum": 0 },
            "correct": { "type": "integer", "minimum": 0 },
            "accuracy": { "oneOf": [{ "type": "null" }, { "$ref": "https://tangleai.dev/schemas/locomo-recall#/definitions/unit" }] },
            "keyword": { "type": "integer", "minimum": 0 },
            "unanswered": { "$ref": "#/definitions/unanswered" },
            "judgeFailed": { "type": "integer", "minimum": 0 },
            "cost": { "$ref": "#/definitions/cost" }
          }
        }
      }
    }
  }
}
