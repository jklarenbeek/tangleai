{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tangleai.dev/schemas/locomo-qa-live",
  "title": "LoCoMo answer-path report, live tier \u2014 the merge of dated runs of one real model",
  "description": "What `benchmark/locomo-qa.ts --live` writes: the same sample as the keyless document, answered by a chat model row by row \u2014 the long-context baseline, the retrieval corpora, the long-horizon agent, Tangle \u2014 with the ceiling beside every F1, the cost beside both, per-question results so rows can be compared over the questions they all answered, and the category-5 judgments apart. Six rows do not fit one request ceiling, so the document is the MERGE of runs: `runs` records each with its plan and spend, and every row says which run produced it. Timing and clock readings ARE in here \u2014 this document records real runs and is never regenerated by a test; the tests validate it and render from it. A `replayed` count (calls the wire cache answered from an earlier run) and a `cached` count (texts it embedded once already) sit beside every spend; both are absent on rows and runs made before the cache existed.",
  "type": "object",
  "required": [
    "benchmark",
    "instrument",
    "generated",
    "dataset",
    "config",
    "sample",
    "runs",
    "configurations",
    "configIdentities"
  ],
  "additionalProperties": false,
  "properties": {
    "benchmark": {
      "const": "locomo"
    },
    "instrument": {
      "const": "locomo-qa-live"
    },
    "generated": {
      "type": "object",
      "required": [
        "at",
        "provider",
        "model",
        "judgeModel",
        "embedder",
        "keySource",
        "thinking"
      ],
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "https://tangleai.dev/schemas/locomo-recall#/definitions/instant",
          "description": "The latest run's instant."
        },
        "provider": {
          "enum": [
            "ollama",
            "openrouter",
            "lmstudio",
            "custom"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "judgeModel": {
          "type": "string",
          "minLength": 1
        },
        "embedder": {
          "type": "object",
          "required": [
            "model",
            "dims"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "dims": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "keySource": {
          "description": "The NAME of the variable the key came from; the key itself may never appear in a report.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          ]
        },
        "thinking": {
          "enum": [
            "off",
            "default"
          ],
          "description": "The answer client's thinking control; the long-horizon row records its own."
        }
      }
    },
    "dataset": {
      "$ref": "https://tangleai.dev/schemas/locomo-recall#/properties/dataset"
    },
    "config": {
      "description": "The keyless document's config, except that a run skipped before the wire answered has no settled width yet (`dims: 0`).",
      "type": "object",
      "required": [
        "embedder",
        "k",
        "ingest",
        "clock",
        "maxPairs"
      ],
      "additionalProperties": false,
      "properties": {
        "embedder": {
          "type": "object",
          "required": [
            "model",
            "dims"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "dims": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "k": {
          "type": "integer",
          "minimum": 1
        },
        "ingest": {
          "const": "per-session"
        },
        "clock": {
          "type": "string",
          "minLength": 1
        },
        "maxPairs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sample": {
      "$ref": "https://tangleai.dev/schemas/locomo-qa#/definitions/sample"
    },
    "runs": {
      "description": "Every run merged into this document, oldest first; a row's `run` indexes here.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/run"
      }
    },
    "configurations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/configuration"
      }
    },
    "configIdentities": {
      "description": "the shared config-identity envelope: historic rows are stated legacy-unrecorded absences and every NEW live row references a complete identity in the table",
      "$ref": "https://tangleai.dev/schemas/run-identity#/$defs/identityEnvelope"
    }
  },
  "definitions": {
    "ingestAsMeasured": {
      "description": "A live report is a dated record of calls that were paid for, so it is never regenerated to a newer shape. A run made before the policies counted their own failures carries the census as it was measured then; a run made after carries the complete one. Backfilling the missing counters with zeros would assert measurements nobody took.",
      "anyOf": [
        {
          "$ref": "https://tangleai.dev/schemas/locomo-recall#/definitions/ingest"
        },
        {
          "$ref": "#/definitions/ingestBeforeFailureAccounting"
        }
      ]
    },
    "ingestBeforeFailureAccounting": {
      "type": "object",
      "required": [
        "runs",
        "observations",
        "embedded",
        "admitted",
        "filtered",
        "judged",
        "contradictions",
        "resolutions",
        "merged",
        "live",
        "total",
        "superseded"
      ],
      "additionalProperties": false,
      "properties": {
        "runs": {
          "type": "integer",
          "minimum": 0
        },
        "observations": {
          "type": "integer",
          "minimum": 0
        },
        "embedded": {
          "type": "integer",
          "minimum": 0
        },
        "admitted": {
          "type": "integer",
          "minimum": 0
        },
        "filtered": {
          "type": "integer",
          "minimum": 0
        },
        "judged": {
          "type": "integer",
          "minimum": 0
        },
        "contradictions": {
          "type": "integer",
          "minimum": 0
        },
        "resolutions": {
          "type": "integer",
          "minimum": 0
        },
        "merged": {
          "type": "integer",
          "minimum": 0
        },
        "live": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "superseded": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "turns",
        "tokens",
        "promptTokens",
        "completionTokens",
        "ms"
      ],
      "additionalProperties": false,
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "promptTokens": {
          "type": "integer",
          "minimum": 0
        },
        "completionTokens": {
          "type": "integer",
          "minimum": 0
        },
        "ms": {
          "type": "number",
          "minimum": 0
        },
        "replayed": {
          "description": "Calls the wire cache answered from an earlier run \u2014 counted here, spent nowhere.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "latency": {
      "type": "object",
      "required": [
        "count",
        "medianMs",
        "p95Ms"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "medianMs": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        },
        "p95Ms": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        }
      }
    },
    "unanswered": {
      "type": "object",
      "required": [
        "wire",
        "budget"
      ],
      "additionalProperties": false,
      "properties": {
        "wire": {
          "type": "integer",
          "minimum": 0
        },
        "budget": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "configuration": {
      "type": "object",
      "required": [
        "key",
        "label",
        "kind",
        "run",
        "questions",
        "f1",
        "ceiling",
        "citedRecall",
        "citations",
        "cost",
        "latency",
        "adversarial"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "https://tangleai.dev/schemas/locomo-qa#/definitions/rowKind"
        },
        "corpus": {
          "$ref": "https://tangleai.dev/schemas/locomo-qa#/definitions/rowCorpus"
        },
        "run": {
          "type": "integer",
          "minimum": 0
        },
        "thresholds": {
          "$ref": "https://tangleai.dev/schemas/locomo-recall#/definitions/thresholds"
        },
        "ingest": {
          "$ref": "#/definitions/ingestAsMeasured"
        },
        "retrieval": {
          "$ref": "https://tangleai.dev/schemas/locomo-qa#/definitions/retrieval"
        },
        "questions": {
          "type": "object",
          "required": [
            "planned",
            "answered",
            "unanswered",
            "invalid",
            "results"
          ],
          "additionalProperties": false,
          "properties": {
            "planned": {
              "type": "integer",
              "minimum": 0
            },
            "answered": {
              "type": "integer",
              "minimum": 0
            },
            "unanswered": {
              "$ref": "#/definitions/unanswered"
            },
            "invalid": {
              "type": "integer",
              "minimum": 0
            },
            "results": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/result"
              }
            },
            "abstained": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "f1": {
          "$ref": "https://tangleai.dev/schemas/locomo-qa#/definitions/byCategory"
        },
        "ceiling": {
          "$ref": "https://tangleai.dev/schemas/locomo-qa#/definitions/byCategory"
        },
        "citedRecall": {
          "$ref": "https://tangleai.dev/schemas/locomo-qa#/definitions/byCategory"
        },
        "citations": {
          "type": "object",
          "required": [
            "cited",
            "uncited",
            "total",
            "unresolved",
            "answersWithUnresolved"
          ],
          "additionalProperties": false,
          "properties": {
            "cited": {
              "type": "integer",
              "minimum": 0
            },
            "uncited": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved": {
              "type": "integer",
              "minimum": 0
            },
            "answersWithUnresolved": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cost": {
          "$ref": "#/definitions/cost"
        },
        "latency": {
          "$ref": "#/definitions/latency"
        },
        "adversarial": {
          "type": "object",
          "required": [
            "planned",
            "judged",
            "correct",
            "accuracy",
            "keyword",
            "unanswered",
            "judgeFailed",
            "cost"
          ],
          "additionalProperties": false,
          "properties": {
            "planned": {
              "type": "integer",
              "minimum": 0
            },
            "judged": {
              "type": "integer",
              "minimum": 0
            },
            "correct": {
              "type": "integer",
              "minimum": 0
            },
            "accuracy": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "https://tangleai.dev/schemas/locomo-recall#/definitions/unit"
                }
              ]
            },
            "keyword": {
              "type": "integer",
              "minimum": 0
            },
            "unanswered": {
              "$ref": "#/definitions/unanswered"
            },
            "judgeFailed": {
              "type": "integer",
              "minimum": 0
            },
            "cost": {
              "$ref": "#/definitions/cost"
            }
          }
        },
        "horizon": {
          "$ref": "#/definitions/horizon"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "pipeline",
              "rag"
            ]
          }
        }
      },
      "then": {
        "required": [
          "corpus",
          "thresholds",
          "ingest",
          "retrieval"
        ]
      }
    },
    "run": {
      "type": "object",
      "required": [
        "at",
        "rows",
        "plan",
        "embedding",
        "spent",
        "errors"
      ],
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "https://tangleai.dev/schemas/locomo-recall#/definitions/instant"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "plan": {
          "type": "object",
          "required": [
            "embedRequests",
            "chatCalls",
            "judgeCalls",
            "planned",
            "maxCalls",
            "skipped"
          ],
          "additionalProperties": false,
          "properties": {
            "embedRequests": {
              "type": "integer",
              "minimum": 0
            },
            "chatCalls": {
              "type": "integer",
              "minimum": 0
            },
            "judgeCalls": {
              "type": "integer",
              "minimum": 0
            },
            "planned": {
              "type": "integer",
              "minimum": 0
            },
            "maxCalls": {
              "type": "integer",
              "minimum": 1
            },
            "skipped": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            }
          }
        },
        "embedding": {
          "type": "object",
          "required": [
            "requests",
            "texts"
          ],
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "integer",
              "minimum": 0
            },
            "texts": {
              "type": "integer",
              "minimum": 0
            },
            "cached": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "spent": {
          "type": "object",
          "required": [
            "turns",
            "tokens",
            "ms"
          ],
          "additionalProperties": false,
          "properties": {
            "turns": {
              "type": "integer",
              "minimum": 0
            },
            "tokens": {
              "type": "integer",
              "minimum": 0
            },
            "ms": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "errors": {
          "type": "object",
          "required": [
            "count",
            "sample"
          ],
          "additionalProperties": false,
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "sample": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "replayed": {
          "description": "Chat calls the wire cache answered in this run, summed over its rows.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "result": {
      "description": "One answered question \u2014 numbers only, never the answer text.",
      "type": "object",
      "required": [
        "id",
        "category",
        "f1",
        "ceiling",
        "citedRecall",
        "cited",
        "unresolved",
        "invalid",
        "tokens",
        "ms"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^conv-[0-9]+#[0-9]+$"
        },
        "category": {
          "enum": [
            1,
            2,
            3,
            4
          ]
        },
        "f1": {
          "$ref": "https://tangleai.dev/schemas/locomo-recall#/definitions/unit"
        },
        "ceiling": {
          "$ref": "https://tangleai.dev/schemas/locomo-recall#/definitions/unit"
        },
        "citedRecall": {
          "$ref": "https://tangleai.dev/schemas/locomo-recall#/definitions/unit"
        },
        "cited": {
          "type": "boolean"
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "boolean"
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "ms": {
          "type": "number",
          "minimum": 0
        },
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "subcalls": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "unvisited": {
          "type": "integer",
          "minimum": 0
        },
        "authored": {
          "type": "boolean"
        },
        "stopped": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "replayed": {
          "type": "integer",
          "minimum": 0
        },
        "promptSha256": {
          "description": "The digest of the serialized context this row put in the prompt. Present when the caller asked for one \u2014 a policy matrix reads its acting set from these bytes, never from a score.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "outcome": {
          "enum": [
            "answered",
            "abstained",
            "invalid"
          ]
        }
      }
    },
    "horizon": {
      "description": "The long-horizon row's bounds and its census \u2014 every one a published column.",
      "type": "object",
      "required": [
        "perCategory",
        "depth",
        "turnsPerQuestion",
        "maxSubcalls",
        "callTimeoutMs",
        "thinking",
        "ids",
        "authored",
        "programs",
        "subcalls",
        "stops"
      ],
      "additionalProperties": false,
      "properties": {
        "perCategory": {
          "type": "integer",
          "minimum": 0
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "turnsPerQuestion": {
          "type": "integer",
          "minimum": 1
        },
        "maxSubcalls": {
          "type": "integer",
          "minimum": 0
        },
        "callTimeoutMs": {
          "type": "integer",
          "minimum": 0
        },
        "thinking": {
          "type": "object",
          "required": [
            "author",
            "subcall"
          ],
          "additionalProperties": false,
          "properties": {
            "author": {
              "enum": [
                "default",
                "off"
              ]
            },
            "subcall": {
              "enum": [
                "off",
                "default"
              ]
            }
          }
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^conv-[0-9]+#[0-9]+$"
          }
        },
        "authored": {
          "type": "object",
          "required": [
            "ok",
            "failed",
            "attempts"
          ],
          "additionalProperties": false,
          "properties": {
            "ok": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "programs": {
          "type": "object",
          "required": [
            "ok",
            "failed"
          ],
          "additionalProperties": false,
          "properties": {
            "ok": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "subcalls": {
          "type": "object",
          "required": [
            "made",
            "failed",
            "unvisited"
          ],
          "additionalProperties": false,
          "properties": {
            "made": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "unvisited": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "stops": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "strategy": {
          "enum": [
            "legacy",
            "covered-evidence-v1"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "chunkSize",
              "totalPieces",
              "visitedPieces",
              "corpusChars",
              "visitedChars",
              "authorAttempts",
              "programAttempts",
              "programFailures",
              "executionRepairs",
              "reusedSubcalls",
              "synthesisAttempts",
              "calls",
              "evidenceRecords",
              "id",
              "policy",
              "policySha256",
              "status",
              "error"
            ],
            "additionalProperties": false,
            "properties": {
              "chunkSize": {
                "type": "integer",
                "minimum": 0
              },
              "totalPieces": {
                "type": "integer",
                "minimum": 0
              },
              "visitedPieces": {
                "type": "integer",
                "minimum": 0
              },
              "corpusChars": {
                "type": "integer",
                "minimum": 0
              },
              "visitedChars": {
                "type": "integer",
                "minimum": 0
              },
              "authorAttempts": {
                "type": "integer",
                "minimum": 0
              },
              "programAttempts": {
                "type": "integer",
                "minimum": 0
              },
              "programFailures": {
                "type": "integer",
                "minimum": 0
              },
              "executionRepairs": {
                "type": "integer",
                "minimum": 0
              },
              "reusedSubcalls": {
                "type": "integer",
                "minimum": 0
              },
              "synthesisAttempts": {
                "type": "integer",
                "minimum": 0
              },
              "calls": {
                "type": "integer",
                "minimum": 0
              },
              "evidenceRecords": {
                "type": "integer",
                "minimum": 0
              },
              "id": {
                "type": "string",
                "pattern": "^conv-[0-9]+#[0-9]+$"
              },
              "policy": {
                "const": "covered-evidence-v1"
              },
              "policySha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "status": {
                "enum": [
                  "answered",
                  "abstained",
                  "invalid",
                  "failed",
                  "budget"
                ]
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
