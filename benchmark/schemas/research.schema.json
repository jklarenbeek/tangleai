{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tangleai.dev/schemas/research",
  "type": "object",
  "properties": {
    "benchmark": {
      "const": "research"
    },
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "clean": {
          "type": "boolean"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "https://tangleai.dev/schemas/research-records#/$defs/Sha256"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "sha256": {
          "$ref": "https://tangleai.dev/schemas/research-records#/$defs/Sha256"
        }
      },
      "required": [
        "head",
        "clean",
        "files",
        "sha256"
      ],
      "additionalProperties": false
    },
    "suite": {
      "type": "object",
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "packages"
      ],
      "additionalProperties": false
    },
    "registration": {
      "type": "object",
      "properties": {
        "id": {
          "const": "research-computational-v1"
        },
        "revision": {
          "$ref": "https://tangleai.dev/schemas/research-records#/$defs/Sha256"
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchId"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "caps": {
          "type": "object",
          "properties": {
            "calls": {
              "const": 128
            },
            "tokens": {
              "const": 131072
            },
            "ms": {
              "const": 120000
            },
            "concurrency": {
              "const": 4
            },
            "contextChars": {
              "const": 65536
            },
            "traceBytes": {
              "const": 1048576
            }
          },
          "required": [
            "calls",
            "tokens",
            "ms",
            "concurrency",
            "contextChars",
            "traceBytes"
          ],
          "additionalProperties": false
        },
        "replicatePolicy": {
          "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ReplicatePolicy"
        },
        "bundles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchId"
              },
              "expected": {
                "$ref": "#/$defs/ResearchRefusal"
              }
            },
            "required": [
              "id",
              "expected"
            ],
            "additionalProperties": false
          },
          "minItems": 21,
          "maxItems": 21
        }
      },
      "required": [
        "id",
        "revision",
        "topics",
        "caps",
        "replicatePolicy",
        "bundles"
      ],
      "additionalProperties": false
    },
    "identity": {
      "$ref": "https://tangleai.dev/schemas/run-identity#/$defs/identityEnvelope"
    },
    "ceilings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topicId": {
            "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchId"
          },
          "literatureRecall": {
            "$ref": "#/$defs/ResearchScore"
          },
          "literaturePrecision": {
            "$ref": "#/$defs/ResearchScore"
          },
          "citationIdentity": {
            "$ref": "#/$defs/ResearchScore"
          },
          "registryAccuracy": {
            "$ref": "#/$defs/ResearchScore"
          }
        },
        "required": [
          "topicId",
          "literatureRecall",
          "literaturePrecision",
          "citationIdentity",
          "registryAccuracy"
        ],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 3
    },
    "rows": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/ResearchMeasuredRow"
          },
          {
            "$ref": "#/$defs/ResearchMissingRow"
          }
        ]
      },
      "minItems": 8,
      "maxItems": 8
    },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchId"
          },
          "expected": {
            "$ref": "#/$defs/ResearchRefusal"
          },
          "observed": {
            "anyOf": [
              {
                "$ref": "#/$defs/ResearchRefusal"
              },
              {
                "type": "null"
              }
            ]
          },
          "refusedAsRegistered": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "expected",
          "observed",
          "refusedAsRegistered"
        ],
        "additionalProperties": false
      },
      "minItems": 21,
      "maxItems": 21
    },
    "disclosure": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rowId": {
            "enum": [
              "artifact-oracle",
              "no-model-runner",
              "single-pass-retrieve-draft",
              "fixed-single-agent",
              "fixed-plus-debate",
              "fixed-plus-branching",
              "gate-only-full",
              "full-auto-full"
            ]
          },
          "items": {
            "$ref": "https://tangleai.dev/schemas/research-records#/$defs/DisclosureChecklist"
          }
        },
        "required": [
          "rowId",
          "items"
        ],
        "additionalProperties": false
      },
      "minItems": 8,
      "maxItems": 8
    },
    "gate": {
      "type": "object",
      "properties": {
        "registration": {
          "type": "boolean"
        },
        "oracle": {
          "type": "boolean"
        },
        "bundles": {
          "type": "boolean"
        },
        "networkCalls": {
          "const": 0
        }
      },
      "required": [
        "registration",
        "oracle",
        "bundles",
        "networkCalls"
      ],
      "additionalProperties": false
    },
    "decision": {
      "enum": [
        "conformant",
        "drift"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "reportId": {
      "$ref": "https://tangleai.dev/schemas/research-records#/$defs/Sha256"
    }
  },
  "required": [
    "benchmark",
    "schemaVersion",
    "source",
    "suite",
    "registration",
    "identity",
    "ceilings",
    "rows",
    "bundles",
    "disclosure",
    "gate",
    "decision",
    "limitations",
    "reportId"
  ],
  "additionalProperties": false,
  "$defs": {
    "ResearchBlobs": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "blobs"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "vector": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "id",
              "vector"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "kind",
        "points"
      ],
      "additionalProperties": false
    },
    "ResearchCorpus": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "corpus"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "pattern": "^[a-z ]+$"
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "pattern": "^[a-z ]+$"
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "kind",
        "documents",
        "queries"
      ],
      "additionalProperties": false
    },
    "ResearchDataset": {
      "oneOf": [
        {
          "$ref": "#/$defs/ResearchBlobs"
        },
        {
          "$ref": "#/$defs/ResearchCorpus"
        }
      ]
    },
    "ResearchHiddenLabels": {
      "type": "object",
      "properties": {
        "topicId": {
          "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchId"
        },
        "relevantLiterature": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "requiredClaims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "literature",
                  "metric",
                  "interpretation"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "literatureId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "observationCondition": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "strength": {
                "enum": [
                  "descriptive",
                  "causal"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "text",
              "literatureId",
              "observationCondition",
              "strength"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "queryGold": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "queryId": {
                "type": "string",
                "minLength": 1
              },
              "relevantIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "queryId",
              "relevantIds"
            ],
            "additionalProperties": false
          }
        },
        "metricTolerance": {
          "type": "number",
          "minimum": 0
        },
        "registeredTruth": {
          "enum": [
            "improvement",
            "SATURATED"
          ]
        }
      },
      "required": [
        "topicId",
        "relevantLiterature",
        "requiredClaims",
        "queryGold",
        "metricTolerance",
        "registeredTruth"
      ],
      "additionalProperties": false
    },
    "ResearchFixtureTopic": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "datasetPath": {
          "type": "string",
          "minLength": 1
        },
        "hiddenPath": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchContract"
        },
        "plan": {
          "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ExperimentPlan"
        },
        "licence": {
          "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchLicence"
        }
      },
      "required": [
        "id",
        "title",
        "datasetPath",
        "hiddenPath",
        "contract",
        "plan",
        "licence"
      ],
      "additionalProperties": false
    },
    "ResearchFixtureManifest": {
      "type": "object",
      "properties": {
        "id": {
          "const": "research-computational-v1"
        },
        "version": {
          "const": 1
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchId"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "path"
            ],
            "additionalProperties": false
          },
          "minItems": 3,
          "maxItems": 3
        },
        "literature": {
          "type": "object",
          "properties": {
            "records": {
              "type": "string",
              "minLength": 1
            },
            "gold": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "records",
            "gold"
          ],
          "additionalProperties": false
        },
        "programs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "https://tangleai.dev/schemas/research-records#/$defs/Sha256"
              },
              "licence": {
                "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchLicence"
              }
            },
            "required": [
              "id",
              "source",
              "sha256",
              "licence"
            ],
            "additionalProperties": false
          },
          "minItems": 9,
          "maxItems": 9
        },
        "datasets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "bundles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchId"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "expected": {
                "$ref": "#/$defs/ResearchRefusal"
              }
            },
            "required": [
              "id",
              "path",
              "expected"
            ],
            "additionalProperties": false
          },
          "minItems": 21,
          "maxItems": 21
        },
        "oracles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topicId": {
                "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchId"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "topicId",
              "path"
            ],
            "additionalProperties": false
          },
          "minItems": 3,
          "maxItems": 3
        },
        "caps": {
          "type": "object",
          "properties": {
            "calls": {
              "const": 128
            },
            "tokens": {
              "const": 131072
            },
            "ms": {
              "const": 120000
            },
            "concurrency": {
              "const": 4
            },
            "contextChars": {
              "const": 65536
            },
            "traceBytes": {
              "const": 1048576
            }
          },
          "required": [
            "calls",
            "tokens",
            "ms",
            "concurrency",
            "contextChars",
            "traceBytes"
          ],
          "additionalProperties": false
        },
        "replicatePolicy": {
          "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ReplicatePolicy"
        },
        "licence": {
          "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchLicence"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "https://tangleai.dev/schemas/research-records#/$defs/Sha256"
              },
              "licence": {
                "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchLicence"
              }
            },
            "required": [
              "path",
              "sha256",
              "licence"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "revision": {
          "$ref": "https://tangleai.dev/schemas/research-records#/$defs/Sha256"
        }
      },
      "required": [
        "id",
        "version",
        "topics",
        "literature",
        "programs",
        "datasets",
        "bundles",
        "oracles",
        "caps",
        "replicatePolicy",
        "licence",
        "members",
        "revision"
      ],
      "additionalProperties": false
    },
    "ResearchScore": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "passed",
        "total",
        "value"
      ],
      "additionalProperties": false,
      "$query": {
        "$and": [
          {
            "$le": [
              "$.passed",
              "$.total"
            ]
          },
          {
            "$eq": [
              "$.value",
              {
                "$div": [
                  "$.passed",
                  "$.total"
                ]
              }
            ]
          }
        ]
      }
    },
    "ResearchRefusal": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^TRSH10(0[1-9]|10)$"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "path"
      ],
      "additionalProperties": false
    },
    "ResearchTopicResult": {
      "type": "object",
      "properties": {
        "topicId": {
          "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchId"
        },
        "preregistrationIntegrity": {
          "$ref": "#/$defs/ResearchScore"
        },
        "literatureRecall": {
          "$ref": "#/$defs/ResearchScore"
        },
        "literaturePrecision": {
          "$ref": "#/$defs/ResearchScore"
        },
        "citationIdentity": {
          "$ref": "#/$defs/ResearchScore"
        },
        "claimSupport": {
          "$ref": "#/$defs/ResearchScore"
        },
        "registryAccuracy": {
          "$ref": "#/$defs/ResearchScore"
        },
        "rerunRate": {
          "$ref": "#/$defs/ResearchScore"
        },
        "confoundDetection": {
          "$ref": "#/$defs/ResearchScore"
        },
        "negativeResultHandling": {
          "$ref": "#/$defs/ResearchScore"
        },
        "branchSelectionCompliance": {
          "$ref": "#/$defs/ResearchScore"
        },
        "gateBehaviour": {
          "$ref": "#/$defs/ResearchScore"
        },
        "tracesCompleteness": {
          "$ref": "#/$defs/ResearchScore"
        },
        "interventions": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "substantive": {
              "type": "integer",
              "minimum": 0
            },
            "approvals": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "total",
            "substantive",
            "approvals"
          ],
          "additionalProperties": false
        },
        "cost": {
          "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchCost"
        },
        "failures": {
          "type": "object",
          "properties": {
            "program": {
              "type": "integer",
              "minimum": 0
            },
            "verification": {
              "type": "integer",
              "minimum": 0
            },
            "leakage": {
              "type": "integer",
              "minimum": 0
            },
            "confound": {
              "type": "integer",
              "minimum": 0
            },
            "budget": {
              "type": "integer",
              "minimum": 0
            },
            "provider": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "program",
            "verification",
            "leakage",
            "confound",
            "budget",
            "provider",
            "unsupported"
          ],
          "additionalProperties": false
        },
        "completion": {
          "$ref": "#/$defs/ResearchScore"
        },
        "result": {
          "enum": [
            "improvement",
            "inconclusive",
            "no-improvement",
            "SATURATED",
            "failed"
          ]
        },
        "bundleHash": {
          "$ref": "https://tangleai.dev/schemas/research-records#/$defs/Sha256"
        },
        "bundle": {
          "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchBundle"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "https://tangleai.dev/schemas/research-records#/$defs/MetricObservation"
          }
        },
        "claimsExpected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "claimsSupported": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "verificationIssues": {
          "type": "array",
          "items": {
            "$ref": "https://tangleai.dev/schemas/research-records#/$defs/ResearchIssue"
          }
        }
      },
      "required": [
        "topicId",
        "preregistrationIntegrity",
        "literatureRecall",
        "literaturePrecision",
        "citationIdentity",
        "claimSupport",
        "registryAccuracy",
        "rerunRate",
        "confoundDetection",
        "negativeResultHandling",
        "branchSelectionCompliance",
