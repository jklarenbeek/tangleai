                  "$registered.id"
                ]
              },
              {
                "$eq": [
                  "$bundle.expected",
                  "$registered.expected"
                ]
              }
            ]
          }
        }
      },
      {
        "$eq": [
          "$.gate.bundles",
          {
            "$every": {
              "bundle": "$.bundles[*]"
            },
            "$satisfies": "$bundle.refusedAsRegistered"
          }
        ]
      },
      {
        "$eq": [
          [
            "$.disclosure[*].rowId"
          ],
          [
            "$.rows[*].id"
          ]
        ]
      },
      {
        "$every": {
          "row": "$.rows[?(@.state==\"measured\")]"
        },
        "$satisfies": {
