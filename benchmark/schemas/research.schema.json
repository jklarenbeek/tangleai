  "$query": {
    "$and": [
      {
        "$eq": [
          [
            "$.rows[*].id"
          ],
          [
            "artifact-oracle",
            "no-model-runner",
            "single-pass-retrieve-draft",
            "fixed-single-agent",
            "fixed-plus-debate",
            "fixed-plus-branching",
            "gate-only-full",
            "full-auto-full"
          ]
        ]
      },
      {
        "$eq": [
          [
            "$.identity.rows[*].rowId"
          ],
