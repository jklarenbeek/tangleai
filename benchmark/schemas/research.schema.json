                    "$bundle.expected.code",
                    "$bundle.observed.code"
                  ]
                },
                {
                  "$eq": [
                    "$bundle.expected.path",
                    "$bundle.observed.path"
                  ]
                }
              ]
            }
          ]
        }
      },
      {
