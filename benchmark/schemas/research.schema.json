            ],
            [
              "$.registration.topics[*]"
            ]
          ]
        }
      },
      {
        "$every": {
          "bundle": "$.bundles[*]"
        },
        "$satisfies": {
          "$eq": [
            "$bundle.refusedAsRegistered",
            {
